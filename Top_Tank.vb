    Private Sub OLTC_CONSERVATOR_REQ_SelectedIndexChanged(sender As Object, e As EventArgs) Handles OLTC_CONSERVATOR_REQ.SelectedIndexChanged

        If OLTC_CONSERVATOR_REQ.SelectedItem = "Yes" Then

            OLTC_CONSERVATOR_POS.Enabled = True
            OLTC_CONSERVATOR_X.Enabled = True
            OLTC_CONSERVATOR_Y.Enabled = True

        ElseIf OLTC_CONSERVATOR_REQ.SelectedItem = "No" Then

            OLTC_CONSERVATOR_POS.Enabled = False
            OLTC_CONSERVATOR_X.Enabled = False
            OLTC_CONSERVATOR_Y.Enabled = False

        End If
    End Sub

