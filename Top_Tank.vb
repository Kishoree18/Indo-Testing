    Private Sub T_TANK_WTH2_MouseClick(sender As Object, e As MouseEventArgs) Handles T_TANK_WTH2.MouseClick

        Load_OLTC_Pkt_Position()
        Dim btm_tk_curb_proV As String = ""

        Try

            Dim wk_odr_No1 As String = Create_Project.wk_ord_No

            Dim connection As New SqlConnection(Main_Panel.connectionString)

            connection.Open()
            Dim query As String = "SELECT * from Bottom_Tank_BT WHERE wk_odr_No = @wk_odr_No"

            Dim cmd As New SqlCommand(query, connection)
            cmd.Parameters.AddWithValue("@wk_odr_No", wk_odr_No1)
            Dim reader As SqlDataReader = cmd.ExecuteReader()

            While reader.Read()


                btm_tk_curb_proV = reader("btm_tk_curb_pro").ToString()

            End While

            connection.Close()

        Catch ex As Exception
            MsgBox("Error" & ex.ToString)
        End Try

        length.Hide()
        width.Hide()
        tanklength.Hide()
        tankwidth.Hide()
        curbsize.Hide()
        tankwall.Hide()

        WHALF.Show()

        tank_pic_box.Image = My.Resources.TT_W2

        Trunk_neu.Hide()
        BP_W.Hide()
        BP_U.Hide()
        TRUNK_H.Hide()
        T_H.Hide()
        top_plate_T.Hide()
        BC.Hide()
        C.Hide()
        B.Hide()
        A.Hide()


        If OLTC_pkt_position = "Left" Then

            If btm_tk_curb_proV = "Type 1" Then
                tank_pic_box.Image = My.Resources.TT_W2L



                WHALF.BackColor = System.Drawing.Color.FromArgb(120, 250, 60)
                WHALF.Location = New System.Drawing.Point(436, 526)

            Else




                WHALF.BackColor = System.Drawing.Color.FromArgb(120, 250, 60)
                WHALF.Location = New System.Drawing.Point(436, 526)


                tank_pic_box.Image = My.Resources.TT_W2L

            End If

        Else
            If btm_tk_curb_proV = "Type 1" Then
                tank_pic_box.Image = My.Resources.TT_W2



                WHALF.BackColor = System.Drawing.Color.FromArgb(120, 250, 60)
                WHALF.Location = New System.Drawing.Point(197, 526)




            Else

                tank_pic_box.Image = My.Resources.TT_W2


                WHALF.BackColor = System.Drawing.Color.FromArgb(120, 250, 60)
                WHALF.Location = New System.Drawing.Point(197, 526)


            End If

        End If

    End Sub

