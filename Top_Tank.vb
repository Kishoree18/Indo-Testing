    Private OLTC_pkt_position As String = ""

    Private Sub Load_OLTC_Pkt_Position()

        Try

            Dim wk_odr_No1 As String =
                Create_Project.wk_ord_No

            Using connection As New SqlConnection(
                Main_Panel.connectionString
            )

                connection.Open()

                Dim query As String =
                    "SELECT OLTC_pkt_position " &
                    "FROM Basic_Input " &
                    "WHERE wk_odr_No = @wk_odr_No"

                Using cmd As New SqlCommand(
                    query,
                    connection
                )

                    cmd.Parameters.AddWithValue(
                        "@wk_odr_No",
                        wk_odr_No1
                    )

                    Dim result As Object =
                        cmd.ExecuteScalar()

                    If result IsNot Nothing AndAlso
                       result IsNot DBNull.Value Then

                        OLTC_pkt_position =
                            result.ToString().Trim()

                    Else

                        OLTC_pkt_position =
                            ""

                    End If

                End Using

            End Using

        Catch ex As Exception

            MsgBox(
                "Error while getting OLTC packet position:" &
                vbCrLf &
                ex.ToString()
            )

        End Try

    End Sub

    'Loading the data from database for dropdown
    Private Sub load_turret_size_U_ph()
        Dim connectionstring = "Server=CTPL-HW-067;Initial Catalog=Indo_tech;User ID=sa;Password=Cadopt@123"
        Dim connection As New SqlConnection(connectionstring)
        Try
            connection.Open()
            Dim query As String = "SELECT Turret_size from Turret_sizes_HV_U_ph"
            Dim command As New SqlCommand(query, connection)
            Dim reader As SqlDataReader = command.ExecuteReader()

            While reader.Read()
                HV_bush_BCT_U.Items.Add(reader("Turret_size").ToString())
            End While

            connection.Close()

        Catch ex As Exception

        End Try

    End Sub

