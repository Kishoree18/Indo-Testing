    Private Sub SetComboByText(cmb As ComboBox, value As String)

        If String.IsNullOrWhiteSpace(value) Then Exit Sub

        value = value.Trim()

        Dim index As Integer = cmb.FindStringExact(value)

        If index >= 0 Then
            cmb.SelectedIndex = index
        Else
            ' Optional: log mismatch for debugging
            ' MsgBox($"Value '{value}' not found in {cmb.Name}")
        End If

    End Sub


