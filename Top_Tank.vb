    Private Sub ShowPicture(
    img As Image,
    x As Integer,
    y As Integer
)

        currentDisplayImage = img
        currentImageX = x
        currentImageY = y

        CableBox_Picture.Image = Nothing
        CableBox_Picture.Invalidate()

    End Sub

    Private Sub CableBox_Picture_Paint(
    sender As Object,
    e As PaintEventArgs
) Handles CableBox_Picture.Paint

        If currentDisplayImage Is Nothing Then
            Exit Sub
        End If

        e.Graphics.DrawImage(
        currentDisplayImage,
        currentImageX,
        currentImageY
    )

    End Sub

