    Private Sub LV_TERM_OPN_SelectedIndexChanged(sender As Object, e As EventArgs) Handles LV_TERM_OPN.SelectedIndexChanged
        If LV_TERM.SelectedItem = "Cable Box" Then
            LVN1_Termination.SelectedItem = "Cable Box"

            If LV_TERM_OPN.SelectedItem = "Single LV" Then
                LV_T1.SelectedItem = "Cable Box"
                LV_T1.Enabled = False
                LV_T2.SelectedItem = "Cable Box"
                LV_T2.Enabled = False

                LVN_C.Enabled = True

                LVN2.Enabled = True
                LV1_U.Enabled = True
                LV2_U.Enabled = True
                LV1_W.Enabled = True
                LV2_W.Enabled = True
                GroupBox52.Enabled = True

                LVN_Termination.SelectedItem = "Single LV"
                LVN1_Termination.SelectedItem = "Cable Box"

                LVN_Termination.Enabled = False

                LV_Termination.SelectedItem = "Single LV"
                LV1_Termination.SelectedItem = "Cable Box"
                LV2_Termination.SelectedItem = "Cable Box"

                LV_Termination.Enabled = False
                LV1_Termination.Enabled = False
                LV2_Termination.Enabled = False

            ElseIf LV_TERM_OPN.SelectedItem = "Dual LV" Then
                LVN_C.Enabled = True
                LV_T1.SelectedItem = "Cable Box"
                LV_T1.Enabled = False
                LV_T2.SelectedItem = "Cable Box"
                LV_T2.Enabled = False

                LVN2.Enabled = True
                LV1_U.Enabled = True
                LV2_U.Enabled = True
                LV1_W.Enabled = True
                LV2_W.Enabled = True
                GroupBox52.Enabled = True

                LVN_Termination.SelectedItem = "Dual LV"
                LVN1_Termination.SelectedItem = "Cable Box"

                LVN_Termination.Enabled = False

                LV_Termination.SelectedItem = "Dual LV"
                LV1_Termination.SelectedItem = "Cable Box"
                LV2_Termination.SelectedItem = "Cable Box"
                LV_Termination.Enabled = False
                LV1_Termination.Enabled = False

            End If




        ElseIf LV_TERM.SelectedItem = "Bare Bushing" Then
            LVN1_Termination.SelectedItem = "Bare Bushing"

            If LV_TERM_OPN.SelectedItem = "Single LV" Then

                LV1GB.Enabled = True
