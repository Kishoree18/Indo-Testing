    Public Sub CB_Term_TT()

        Try

            Dim connection As New SqlConnection(Main_Panel.connectionString)

            connection.Open()


            '========================================================
            ' Step 1: Check if record exists
            '========================================================

            Dim checkQuery As String =
            "SELECT COUNT(*) FROM CB_Term_TT " &
            "WHERE wk_odr_No = @wk_odr_No"

            Dim checkCmd As New SqlCommand(checkQuery, connection)

            checkCmd.Parameters.AddWithValue(
            "@wk_odr_No",
            Create_Project.wk_ord_No
        )

            Dim count As Integer =
            Convert.ToInt32(checkCmd.ExecuteScalar())


            '========================================================
            ' Step 2: Prepare UPDATE or INSERT Query
            '========================================================

            Dim query As String


            If count > 0 Then

                '====================================================
                ' UPDATE EXISTING RECORD
                '====================================================

                query =
                "UPDATE CB_Term_TT SET " &
                "Username = @Username, " &
                "CB_Type = @CB_Type, " &
                "CB_X = @CB_X, " &
                "CB_Y = @CB_Y, " &
                "CB_Mounting_POS = @CB_Mounting_POS, " &
                "CB_BTM_Length = @CB_BTM_Length, " &
                "CB_WTH = @CB_WTH, " &
                "CB_Length = @CB_Length, " &
                "Bushing_C_Gland_HT = @Bushing_C_Gland_HT, " &
                "CB_Space_Heater = @CB_Space_Heater, " &
                "CB_BreatherPipe = @CB_BreatherPipe, " &
                "CB_BreatherPipe_POS = @CB_BreatherPipe_POS, " &
                "CB_Front_Inspec_Cover = @CB_Front_Inspec_Cover, " &
                "Bushing_Top_Plt_HT = @Bushing_Top_Plt_HT, " &
                "CB_Gland_Plt_Mat = @CB_Gland_Plt_Mat, " &
                "CB_Gland_POS = @CB_Gland_POS, " &
                "CB_Insulation_Distance1 = @CB_Insulation_Distance1, " &
                "CB_Insulation_Distance2 = @CB_Insulation_Distance2, " &
                "CB_Insulation_Distance3 = @CB_Insulation_Distance3, " &
                "CB_Desiccators = @CB_Desiccators " &
                "WHERE wk_odr_No = @wk_odr_No"

            Else

                '====================================================
                ' INSERT NEW RECORD
