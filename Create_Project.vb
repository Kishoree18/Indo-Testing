                                                Exit For
                                            Catch exDel As Exception
                                                'MsgBox("⚠ Failed to delete '" & featName & "': " & exDel.Message)
                                            End Try
                                        End If
                                    Next
                                Next

                                ' === Update and save part ===
                                partDoc.Update()
                                'partDoc.Save()
                            End If
                        Next

