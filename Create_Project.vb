                mainOccName.Split(":"c)(0).
                Trim().
                ToUpper()


                        Dim actualFileName As String = ""


                        Try

                            actualFileName =
                    System.IO.Path.
                    GetFileNameWithoutExtension(
                        mainOcc.Definition.Document.FullFileName
                    ).
                    ToUpper()

                        Catch

                            actualFileName = ""

                        End Try


                        If mainBaseName = "CABLE_BOX_NEW" OrElse
               mainBaseName = "CABLE_BOX_NEW.IAM" OrElse
               actualFileName = "CABLE_BOX_NEW" Then


                            CableBoxNewAsm = mainOcc


