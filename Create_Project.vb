                        Integer.TryParse(oltc_stiffner2_count.ToString(), stiffSide2)

                        '6. Read the Oil Sampling Valve Selection
                        ' REPLACE "OIL_SAMPLING_VALVE_POSITION" with your actual parameter name
                        Dim sampling_valveSelection As String = SAM_VAL_POSV.ToString().ToUpper().Trim()
                        Dim filter_valveSelection As String = FILTER_VAL_POS.ToString().ToUpper().Trim()
                        Dim drain_valveSelection As String = DRAIN_VALVE_POS.ToString().ToUpper().Trim()
                        Dim dga_valveSelection As String = DGA_VALVE_POS.ToString().ToUpper().Trim()

                        Dim DGA_isValveRequired As Boolean = (DGA_valve_req.ToString().ToUpper().Trim() = "YES")
                        Dim NIFPS_HV_isValveRequired As Boolean = (N2_filling_req_HV.ToString().ToUpper().Trim() = "YES")
                        Dim NIFPS_LV_isValveRequired As Boolean = (N2_filling_req_LV.ToString().ToUpper().Trim() = "YES")
                        Dim NIFPS_OLTCOPP_isValveRequired As Boolean = (N2_filling_req_OLTC_opp.ToString().ToUpper().Trim() = "YES")
                        Dim NIFPS_OLTC_isValveRequired As Boolean = (N2_filling_req_OLTC.ToString().ToUpper().Trim() = "YES")
                        Dim HVPAD_isValveRequired As Boolean = (EARTHINGPAD_HV.ToString().ToUpper().Trim() = "YES")
                        Dim LVPAD_isValveRequired As Boolean = (EARTHINGPAD_POS.ToString().ToUpper().Trim() = "YES")

                        ' ==========================================================
                        ' SECTION A: JACKING PADS & MAIN STIFFENERS (Count Based)
                        ' ==========================================================
