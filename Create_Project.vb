                            browserName = "INSPECTION_COVER_686_TRUNK_B" OrElse
                            browserName = "INSPECTION_COVER_686_TRUNK_B.IPT" OrElse
                            actualFileName = "INSPECTION_COVER_686_TRUNK_B"


                                    '================================================
                                    ' CHECK TOP INSPECTION COVER
                                    '
                                    ' INSPECTION_COVER_686_TRUNK_T.ipt
                                    '================================================

                                    Dim isTopCover As Boolean =
                            browserName = "INSPECTION_COVER_686_TRUNK_T" OrElse
                            browserName = "INSPECTION_COVER_686_TRUNK_T.IPT" OrElse
                            actualFileName = "INSPECTION_COVER_686_TRUNK_T"


                                    '********************************************************
                                    ' SIDE
                                    '
                                    ' BOTTOM COVER = SUPPRESS ALL
                                    ' TOP COVER    = UNSUPPRESS ALL
                                    '********************************************************

                                    If selectedCBType = "SIDE" Then


                                        If isBottomCover Then

                                            bottomCoverCount += 1

                                            If Not comp.Suppressed Then

                                                comp.Suppress()

                                            End If

                                        End If


                                        If isTopCover Then

                                            topCoverCount += 1

                                            If comp.Suppressed Then

                                                comp.Unsuppress()

                                            End If

                                        End If


                                        '********************************************************
                                        ' TOP
                                        '
                                        ' TOP COVER    = SUPPRESS ALL
                                        ' BOTTOM COVER = UNSUPPRESS ALL
                                        '********************************************************

                                    ElseIf selectedCBType = "TOP" Then


                                        If isTopCover Then

                                            topCoverCount += 1

                                            If Not comp.Suppressed Then

                                                comp.Suppress()

                                            End If

                                        End If


                                        If isBottomCover Then

                                            bottomCoverCount += 1

                                            If comp.Suppressed Then

                                                comp.Unsuppress()

                                            End If

                                        End If

                                    End If

