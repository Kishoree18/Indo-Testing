                                ' GET RADIATOR COUNT
                                '
                                ' VALID:
                                ' 3, 4, 5, 6, 7, 8
                                '====================================================

                                Dim radiatorCount As Integer = 0


                                Integer.TryParse(
                Convert.ToString(N0_RAD_HV).Trim(),
                radiatorCount
            )


                                If radiatorCount >= 3 AndAlso
               radiatorCount <= 8 Then


                                    '================================================
                                    ' CHECK RAD_CUT_1 TO RAD_CUT_8
                                    '================================================

                                    For cutNo As Integer = 1 To 8


                                        Dim expectedName As String =
                        "RAD_CUT_" &
                        cutNo.ToString()


                                        '============================================
                                        ' SEARCH FOR THIS EXTRUSION
                                        '============================================

                                        For Each feat As Inventor.ExtrudeFeature _
                        In prtDef.Features.ExtrudeFeatures


                                            Dim featureName As String =
                            feat.Name.
                            Trim().
                            ToUpperInvariant()


                                            If featureName =
                           expectedName.ToUpperInvariant() Then


                                                '************************************
                                                ' CUT NUMBER IS WITHIN
                                                ' SELECTED RADIATOR COUNT
                                                '
                                                ' UNSUPPRESS
                                                '************************************

                                                If cutNo <= radiatorCount Then

                                                    If feat.Suppressed Then

                                                        feat.Suppressed =
                                        False

                                                    End If


                                                    '************************************
                                                    ' CUT NUMBER IS ABOVE
                                                    ' SELECTED RADIATOR COUNT
                                                    '
                                                    ' SUPPRESS
                                                    '************************************

                                                Else

                                                    If Not feat.Suppressed Then

                                                        feat.Suppressed =
                                        True

                                                    End If

                                                End If


                                                Exit For

                                            End If

                                        Next

                                    Next


                                    '================================================
                                    ' UPDATE AND SAVE PART
                                    '
                                    ' IMPORTANT:
                                    ' ALWAYS SAVE BECAUSE THIS CODE CAN BOTH
                                    ' SUPPRESS AND UNSUPPRESS FEATURES.
                                    '================================================

                                    prtDoc.Update()
                                    prtDoc.Save()


