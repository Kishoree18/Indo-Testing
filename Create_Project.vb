    Private Sub InitialiseViewBoundingBox(DView As DrawingView)
        ' Check if ThisApplication is null
        If ThisApplication Is Nothing Then
            MsgBox("Inventor Application instance not found.")
            Exit Sub
        End If

        Dim TransGeom As TransientGeometry = ThisApplication.TransientGeometry

        ' Ensure DView itself isn't null
        If DView Is Nothing Then Exit Sub

        Dim TopLeft As Point2d = TransGeom.CreatePoint2d(DView.Left, DView.Top)
        Dim TopRight As Point2d = TransGeom.CreatePoint2d(DView.Left + DView.Width, DView.Top)
        Dim BtmLeft As Point2d = TransGeom.CreatePoint2d(DView.Left, DView.Top - DView.Height)
        Dim BtmRight As Point2d = TransGeom.CreatePoint2d(DView.Left + DView.Width, DView.Top - DView.Height)

        _topLine = TransGeom.CreateLineSegment2d(TopLeft, TopRight)
        _btmLine = TransGeom.CreateLineSegment2d(BtmLeft, BtmRight)
        _leftLine = TransGeom.CreateLineSegment2d(TopLeft, BtmLeft)
        _rightLine = TransGeom.CreateLineSegment2d(TopRight, BtmRight)

        _blnViewMargin = 2
        _blnVerticalOffset = 0.9
        _blnHorizontalOffset = 1
    End Sub

