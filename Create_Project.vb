                    Try
                        ' 1. Explicitly cast the generic document to a DrawingDocument
                        ' This prevents the COM "E_NOINTERFACE" (0x80004002) error
                        Dim drawingDoc As DrawingDocument = TryCast(drwDoc, DrawingDocument)
                        If drawingDoc Is Nothing Then Exit Try

                        ' 2. Filter by File Name
                        Dim currentDrawingName As String = System.IO.Path.GetFileName(drawingDoc.FullFileName).ToUpper().Trim()
