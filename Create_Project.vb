                        '================================================
                        ' IMPORTANT CHANGE
                        '
                        ' GET ACTUAL CABLE_BOX_NEW ASSEMBLY DOCUMENT
                        '
                        ' Do not suppress using:
                        '
                        ' CableBoxNewAsm.SubOccurrences
                        '
                        ' Instead work directly with native occurrences
                        ' inside CABLE_BOX_NEW.iam
                        '================================================

                        Dim cableBoxAsmDoc As Inventor.AssemblyDocument =
                TryCast(
                    CableBoxNewAsm.Definition.Document,
                    Inventor.AssemblyDocument
                )


                        If cableBoxAsmDoc IsNot Nothing Then


                            Dim cableBoxAsmDef As Inventor.AssemblyComponentDefinition =
                    cableBoxAsmDoc.ComponentDefinition


                            '================================================
                            ' LOOP DIRECTLY THROUGH CABLE_BOX_NEW PARTS
                            '================================================

                            For Each partOcc As Inventor.ComponentOccurrence _
                    In cableBoxAsmDef.Occurrences


                                Dim occName As String =
                        partOcc.Name


                                '--------------------------------------------
                                ' Remove :1, :2, :3 etc.
                                '
                                ' MS_BOSS:1
                                '       ↓
                                ' MS_BOSS
                                '--------------------------------------------

                                Dim baseName As String =
                        occName.Split(":"c)(0).
                        Trim().
                        ToUpper()


                                '================================================
                                ' CONDITION 1 : SPACE HEATER
                                '
                                ' YES -> MS_BOSS UNSUPPRESS
                                ' NO  -> MS_BOSS SUPPRESS
                                '================================================

                                If baseName = "MS_BOSS" OrElse
                       baseName = "MS_BOSS.IPT" Then


                                    If SpaceHeaterValue = "YES" Then


                                        If partOcc.Suppressed Then

                                            partOcc.Unsuppress()

                                        End If


                                    ElseIf SpaceHeaterValue = "NO" Then


                                        If Not partOcc.Suppressed Then

                                            partOcc.Suppress()

                                        End If


                                    End If


                                End If


                                '================================================
                                ' CONDITION 2 : BREATHER PIPE LEFT
                                '================================================

                                If baseName = "BREATHER_PIPE_L" OrElse
                       baseName = "BREATHER_PIPE_L.IPT" Then


                                    '--------------------------------------------
                                    ' Breather = NO
                                    ' Suppress Left
                                    '--------------------------------------------

                                    If BreatherPipeValue = "NO" Then


                                        If Not partOcc.Suppressed Then

                                            partOcc.Suppress()

                                        End If


                                        '--------------------------------------------
                                        ' Breather = YES + LEFT
                                        ' Unsuppress Left
                                        '--------------------------------------------

                                    ElseIf BreatherPipeValue = "YES" AndAlso
                               BreatherPipePosition = "LEFT" Then


                                        If partOcc.Suppressed Then

                                            partOcc.Unsuppress()

                                        End If


                                        '--------------------------------------------
                                        ' Breather = YES + RIGHT
                                        ' Suppress Left
                                        '--------------------------------------------

                                    ElseIf BreatherPipeValue = "YES" AndAlso
                               BreatherPipePosition = "RIGHT" Then


                                        If Not partOcc.Suppressed Then

                                            partOcc.Suppress()

                                        End If


                                    End If


                                End If


                                '================================================
                                ' CONDITION 2 : BREATHER PIPE RIGHT
                                '================================================

                                If baseName = "BREATHER_PIPE_R" OrElse
                       baseName = "BREATHER_PIPE_R.IPT" Then


                                    '--------------------------------------------
                                    ' Breather = NO
                                    ' Suppress Right
                                    '--------------------------------------------

                                    If BreatherPipeValue = "NO" Then


                                        If Not partOcc.Suppressed Then

                                            partOcc.Suppress()

                                        End If


                                        '--------------------------------------------
                                        ' Breather = YES + RIGHT
                                        ' Unsuppress Right
                                        '--------------------------------------------

                                    ElseIf BreatherPipeValue = "YES" AndAlso
                               BreatherPipePosition = "RIGHT" Then


                                        If partOcc.Suppressed Then

                                            partOcc.Unsuppress()

                                        End If


                                        '--------------------------------------------
                                        ' Breather = YES + LEFT
                                        ' Suppress Right
                                        '--------------------------------------------

                                    ElseIf BreatherPipeValue = "YES" AndAlso
                               BreatherPipePosition = "LEFT" Then


                                        If Not partOcc.Suppressed Then

                                            partOcc.Suppress()

                                        End If


                                    End If


                                End If


                                '================================================
                                ' CONDITION 3 : DESICCATOR
                                '
                                ' YES -> UNSUPPRESS
                                ' NO  -> SUPPRESS
                                '================================================

                                If baseName = "DECICATOR" OrElse
                       baseName = "DECICATOR.IPT" Then

                                    If DesiccatorValue = "YES" Then

                                        If partOcc.Suppressed Then

                                            partOcc.Unsuppress()

                                        End If


                                    ElseIf DesiccatorValue = "NO" Then

                                        If Not partOcc.Suppressed Then

                                            partOcc.Suppress()

                                        End If


                                    End If


                                End If


                            Next


                            '================================================
                            ' UPDATE CABLE BOX ASSEMBLY FIRST
                            '================================================

                            cableBoxAsmDoc.Update()


                            '================================================
                            ' THEN UPDATE MAIN ASSEMBLY
                            '================================================

                            asmDoc.Update()


                        Else


                            MsgBox(
                    "Unable to access CABLE_BOX_NEW.iam " &
                    "as an AssemblyDocument."
                )


                        End If


                    Else


                        MsgBox(
                "CABLE_BOX_NEW.iam not found " &
                "inside the active assembly."
            )


                    End If


                Else


                    MsgBox(
            "Active document is not an Assembly."
        )


                End If


            Catch ex As Exception


                MsgBox(
        "Error while updating Cable Box components :" &
        vbCrLf &
        vbCrLf &
        ex.ToString()
    )


            End Try

            'TERMINATION - TRUNK & DC CT BOX SUPPRESS & REPLACE
            Try

                '============================================================
                ' GET INVENTOR APPLICATION
                '============================================================

                Dim invApp As Inventor.Application =
        CType(
            System.Runtime.InteropServices.Marshal.GetActiveObject(
                "Inventor.Application"
            ),
            Inventor.Application
        )


                '============================================================
                ' CHECK ACTIVE DOCUMENT
                '============================================================

                If invApp.ActiveDocumentType =
        Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then


                    Dim asmDoc As Inventor.AssemblyDocument =
            CType(
                invApp.ActiveDocument,
                Inventor.AssemblyDocument
            )

                    Dim asmDef As Inventor.AssemblyComponentDefinition =
            asmDoc.ComponentDefinition


                    '========================================================
                    ' READ INPUTS
                    '========================================================

                    Dim cbTypeValue As String =
            CB_Type.Trim().ToUpperInvariant()

                    Dim refText As String =
            CTBox_Ref.Trim().
            ToUpperInvariant().
            Replace(" ", "")

                    Dim qtyText As String =
            CTBox_Qty.Trim().
            ToUpperInvariant().
            Replace(" ", "").
            Replace(".", "")


                    '========================================================
                    ' SELECTED REF
                    '========================================================

                    Dim selectedRef As Integer = 0

                    If refText.Contains("REF1") Then

                        selectedRef = 1

                    ElseIf refText.Contains("REF2") Then

                        selectedRef = 2

                    ElseIf refText.Contains("REF3") Then

                        selectedRef = 3

                    End If


                    '========================================================
                    ' REQUIRED QUANTITY
                    '========================================================

                    Dim requiredQty As Integer = 0

                    If qtyText.Contains("QTY1") Then

                        requiredQty = 1

                    ElseIf qtyText.Contains("QTY3") Then

                        requiredQty = 3

                    End If


                    '========================================================
                    ' VALIDATE INPUT
                    '========================================================

                    Dim inputValid As Boolean = True

                    If cbTypeValue <> "SIDE" AndAlso
           cbTypeValue <> "TOP" Then

                        MsgBox("CB Type must be Side or Top.")

                        inputValid = False

                    End If


                    If selectedRef = 0 Then

                        MsgBox("CT Box Ref must be Ref1, Ref2 or Ref3.")

                        inputValid = False

                    End If


                    If requiredQty <> 1 AndAlso
           requiredQty <> 3 Then

                        MsgBox(
                "CT Box Qty must be QTY 1 Nos. or QTY 3 Nos."
            )

                        inputValid = False

                    End If


                    If inputValid Then


                        '====================================================
                        ' FIND TRUNK_NEW_FOR_CB.iam
                        '====================================================

                        Dim trunkOccurrence As Inventor.ComponentOccurrence =
                Nothing


                        For Each occ As Inventor.ComponentOccurrence _
                In asmDef.Occurrences


                            Dim browserName As String =
                    occ.Name.Split(":"c)(0).
                    Trim().
                    ToUpperInvariant()


                            Dim actualFileName As String = ""

                            Try

                                actualFileName =
                        System.IO.Path.
                        GetFileNameWithoutExtension(
                            occ.Definition.Document.FullFileName
                        ).
                        ToUpperInvariant()

                            Catch

                                actualFileName = ""

                            End Try


                            If browserName = "TRUNK_NEW_FOR_CB" OrElse
                   browserName = "TRUNK_NEW_FOR_CB.IAM" OrElse
                   actualFileName = "TRUNK_NEW_FOR_CB" Then

                                trunkOccurrence = occ

                                Exit For

                            End If

                        Next


                        '====================================================
                        ' IF TRUNK ASSEMBLY FOUND
                        '====================================================

                        If trunkOccurrence IsNot Nothing Then


                            If trunkOccurrence.Suppressed Then

                                trunkOccurrence.Unsuppress()

                            End If


                            Dim trunkAsmDoc As Inventor.AssemblyDocument =
                    CType(
                        trunkOccurrence.Definition.Document,
                        Inventor.AssemblyDocument
                    )

                            Dim trunkAsmDef As Inventor.AssemblyComponentDefinition =
                    trunkAsmDoc.ComponentDefinition


                            '================================================
                            ' ENTRY TYPE
                            '================================================

                            Dim activeCode As String = ""
                            Dim oppositeCode As String = ""

                            If cbTypeValue = "SIDE" Then

                                activeCode = "S"
                                oppositeCode = "T"

                            ElseIf cbTypeValue = "TOP" Then

                                activeCode = "T"
                                oppositeCode = "S"

                            End If


                            '================================================
                            ' STEP 1
                            '
                            ' SUPPRESS ALL OPPOSITE ENTRY PARTS
                            '================================================

                            For Each partOcc As Inventor.ComponentOccurrence _
                    In trunkAsmDef.Occurrences


                                Dim occName As String =
                        partOcc.Name.Split(":"c)(0).
                        Trim().
                        ToUpperInvariant()


                                Dim modelName As String =
                        occName


                                Try

                                    Dim fullName As String =
                            partOcc.Definition.Document.FullFileName

                                    If Not String.IsNullOrWhiteSpace(fullName) Then

                                        modelName =
                                System.IO.Path.
                                GetFileNameWithoutExtension(
                                    fullName
                                ).
                                ToUpperInvariant()

                                    End If

                                Catch

                                    modelName = occName

                                End Try


                                For refNo As Integer = 1 To 3

                                    For positionNo As Integer = 1 To 3


                                        Dim oppositeName As String =
                                "TRUNK_CT_BOX_REF" &
                                refNo.ToString() &
                                "_" &
                                oppositeCode &
                                positionNo.ToString()


                                        If modelName = oppositeName Then

                                            If Not partOcc.Suppressed Then

                                                partOcc.Suppress()

                                            End If

                                        End If


                                    Next

                                Next


                            Next


                            '================================================
                            ' STEP 2
                            '
                            ' PROCESS POSITION 1 / 2 / 3
                            '================================================

                            Dim warningMessage As String = ""


                            For positionNo As Integer = 1 To 3


                                '================================================
                                ' FIND CURRENT OCCURRENCE FOR THIS POSITION
                                '
                                ' Example position S1:
                                '
                                ' REF1_S1
                                ' OR
                                ' REF2_S1
                                ' OR
                                ' REF3_S1
                                '
                                '================================================

                                Dim currentOccurrence As Inventor.ComponentOccurrence = Nothing


                                For Each partOcc As Inventor.ComponentOccurrence _
                        In trunkAsmDef.Occurrences


                                    Dim occName As String =
                            partOcc.Name.Split(":"c)(0).
                            Trim().
                            ToUpperInvariant()


                                    Dim modelName As String =
                            occName


                                    Try

                                        Dim fullName As String =
                                partOcc.Definition.Document.FullFileName

                                        If Not String.IsNullOrWhiteSpace(fullName) Then

                                            modelName =
                                    System.IO.Path.
                                    GetFileNameWithoutExtension(
                                        fullName
                                    ).
                                    ToUpperInvariant()

                                        End If

                                    Catch

                                        modelName = occName

                                    End Try


                                    For refNo As Integer = 1 To 3


                                        Dim possibleName As String =
                                "TRUNK_CT_BOX_REF" &
                                refNo.ToString() &
                                "_" &
                                activeCode &
                                positionNo.ToString()


                                        If modelName = possibleName Then

                                            currentOccurrence = partOcc

                                            Exit For

                                        End If


                                    Next


                                    If currentOccurrence IsNot Nothing Then

                                        Exit For

                                    End If


                                Next


                                '================================================
                                ' QTY 1
                                '
                                ' Position 1 = active
                                ' Position 2 = suppressed
                                ' Position 3 = suppressed
                                '================================================

                                If requiredQty = 1 Then


                                    If positionNo = 1 Then


                                        If currentOccurrence IsNot Nothing Then


                                            If currentOccurrence.Suppressed Then

                                                currentOccurrence.Unsuppress()

                                            End If


                                            '------------------------------------
                                            ' BUILD SELECTED REF FILE
                                            '------------------------------------

                                            Dim targetFileName As String =
                                    "TRUNK_CT_BOX_REF" &
                                    selectedRef.ToString() &
                                    "_" &
                                    activeCode &
                                    "1.ipt"


                                            Dim currentPath As String =
                                    currentOccurrence.
                                    Definition.
                                    Document.
                                    FullFileName


                                            Dim folderPath As String =
                                    System.IO.Path.
                                    GetDirectoryName(
                                        currentPath
                                    )


                                            Dim targetPath As String =
                                    System.IO.Path.Combine(
                                        folderPath,
                                        targetFileName
                                    )


                                            '------------------------------------
                                            ' REPLACE POSITION 1
                                            '------------------------------------

                                            If System.IO.File.Exists(
                                    targetPath
                                ) Then


                                                Dim currentModelName As String =
                                        System.IO.Path.
                                        GetFileNameWithoutExtension(
                                            currentPath
                                        ).
                                        ToUpperInvariant()


                                                Dim targetModelName As String =
                                        System.IO.Path.
                                        GetFileNameWithoutExtension(
                                            targetPath
                                        ).
                                        ToUpperInvariant()


                                                If currentModelName <>
                                        targetModelName Then


                                                    currentOccurrence.Replace(
                                            targetPath,
                                            False
                                        )


                                                End If


                                            Else


                                                warningMessage &=
                                        vbCrLf &
                                        "File not found: " &
                                        targetPath


                                            End If


                                        Else


                                            warningMessage &=
                                    vbCrLf &
                                    "No occurrence found for " &
                                    activeCode &
                                    "1"


                                        End If


                                    Else


                                        '----------------------------------------
                                        ' Position 2 and 3 not required
                                        '----------------------------------------

                                        If currentOccurrence IsNot Nothing Then

                                            If Not currentOccurrence.Suppressed Then

                                                currentOccurrence.Suppress()

                                            End If

                                        End If


                                    End If


                                    '================================================
                                    ' QTY 3
                                    '
                                    ' Position 1,2,3 must all be active
                                    '================================================

                                ElseIf requiredQty = 3 Then


                                    If currentOccurrence IsNot Nothing Then


                                        '----------------------------------------
                                        ' If S2/S3 or T2/T3 suppressed,
                                        ' first UNSUPPRESS them
                                        '----------------------------------------

                                        If currentOccurrence.Suppressed Then

                                            currentOccurrence.Unsuppress()

                                        End If


                                        '----------------------------------------
                                        ' Build selected REF file for
                                        ' same position
                                        '
                                        ' S1 -> Ref2_S1
                                        ' S2 -> Ref2_S2
                                        ' S3 -> Ref2_S3
                                        '----------------------------------------

                                        Dim targetFileName As String =
                                "TRUNK_CT_BOX_REF" &
                                selectedRef.ToString() &
                                "_" &
                                activeCode &
                                positionNo.ToString() &
                                ".ipt"


                                        Dim currentPath As String =
                                currentOccurrence.
                                Definition.
                                Document.
                                FullFileName


                                        Dim folderPath As String =
                                System.IO.Path.
                                GetDirectoryName(
                                    currentPath
                                )


                                        Dim targetPath As String =
                                System.IO.Path.Combine(
                                    folderPath,
                                    targetFileName
                                )


                                        If System.IO.File.Exists(
                                targetPath
                            ) Then


                                            Dim currentModelName As String =
                                    System.IO.Path.
                                    GetFileNameWithoutExtension(
                                        currentPath
                                    ).
                                    ToUpperInvariant()


                                            Dim targetModelName As String =
                                    System.IO.Path.
                                    GetFileNameWithoutExtension(
                                        targetPath
                                    ).
                                    ToUpperInvariant()


                                            '------------------------------------
                                            ' Replace only when REF differs
                                            '------------------------------------

                                            If currentModelName <>
                                    targetModelName Then


                                                currentOccurrence.Replace(
                                        targetPath,
                                        False
                                    )


                                            End If


                                        Else


                                            warningMessage &=
                                    vbCrLf &
                                    "File not found: " &
                                    targetPath


                                        End If


                                    Else


                                        warningMessage &=
                                vbCrLf &
                                "No occurrence found for " &
                                activeCode &
                                positionNo.ToString()


                                    End If


                                End If


                            Next


                            '================================================
                            ' UPDATE
                            '================================================

                            trunkAsmDoc.Update()

                            asmDoc.Update()


                            '================================================
                            ' WARNINGS
                            '================================================

                            If Not String.IsNullOrWhiteSpace(
                    warningMessage
                ) Then

                                MsgBox(
                        "CT Box update completed with warnings:" &
                        vbCrLf &
                        warningMessage
                    )

                            End If


                        Else


                            MsgBox(
                    "TRUNK_NEW_FOR_CB.iam not found."
                )


                        End If


                    End If


                Else


                    MsgBox(
            "Active document is not an Assembly."
        )


                End If


            Catch ex As Exception


                MsgBox(
        "Error while updating Trunk CT Box:" &
        vbCrLf &
        vbCrLf &
        ex.ToString()
    )


            End Try

            'TERMINATION - TRUNK & DC CT QUANTITY SUPPRESS
            Try

                '============================================================
                ' GET INVENTOR APPLICATION
                '============================================================

                Dim invApp As Inventor.Application =
        CType(
            System.Runtime.InteropServices.Marshal.GetActiveObject(
                "Inventor.Application"
            ),
            Inventor.Application
        )


                '============================================================
                ' CHECK ACTIVE DOCUMENT IS ASSEMBLY
                '============================================================

                If invApp.ActiveDocumentType =
        Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then


                    Dim asmDoc As Inventor.AssemblyDocument =
            CType(
                invApp.ActiveDocument,
                Inventor.AssemblyDocument
            )

                    Dim asmDef As Inventor.AssemblyComponentDefinition =
            asmDoc.ComponentDefinition


                    '========================================================
                    ' READ CB CT QUANTITY
                    '========================================================

                    Dim cbCTQtyValue As String =
            CB_CT_Qty.Trim().
            ToUpperInvariant().
            Replace(" ", "").
            Replace(".", "")


                    '========================================================
                    ' FIND TRUNK_NEW_FOR_CB.iam
                    '========================================================

                    Dim trunkOccurrence As Inventor.ComponentOccurrence =
            Nothing


                    For Each occ As Inventor.ComponentOccurrence _
            In asmDef.Occurrences


                        Dim browserName As String =
                occ.Name.Split(":"c)(0).
                Trim().
                ToUpperInvariant()


                        Dim actualFileName As String = ""

                        Try

                            actualFileName =
                    System.IO.Path.
                    GetFileNameWithoutExtension(
                        occ.Definition.Document.FullFileName
                    ).
                    ToUpperInvariant()

                        Catch

                            actualFileName = ""

                        End Try


                        If browserName = "TRUNK_NEW_FOR_CB" OrElse
               browserName = "TRUNK_NEW_FOR_CB.IAM" OrElse
               actualFileName = "TRUNK_NEW_FOR_CB" Then

                            trunkOccurrence = occ

                            Exit For

                        End If


                    Next


                    '========================================================
                    ' PROCESS ONLY IF TRUNK ASSEMBLY FOUND
                    '========================================================

                    If trunkOccurrence IsNot Nothing Then


                        If trunkOccurrence.Suppressed Then

                            trunkOccurrence.Unsuppress()

                        End If


                        Dim trunkAsmDoc As Inventor.AssemblyDocument =
                CType(
                    trunkOccurrence.Definition.Document,
                    Inventor.AssemblyDocument
                )

                        Dim trunkAsmDef As Inventor.AssemblyComponentDefinition =
                trunkAsmDoc.ComponentDefinition


                        '====================================================
                        ' LOOP THROUGH PARTS INSIDE TRUNK_NEW_FOR_CB
                        '====================================================

                        For Each partOcc As Inventor.ComponentOccurrence _
                In trunkAsmDef.Occurrences


                            Dim browserPartName As String =
                    partOcc.Name.Split(":"c)(0).
                    Trim().
                    ToUpperInvariant()


                            Dim actualPartName As String =
                    browserPartName


                            Try

                                Dim fullFileName As String =
                        partOcc.Definition.Document.FullFileName

                                If Not String.IsNullOrWhiteSpace(
                        fullFileName
                    ) Then

                                    actualPartName =
                            System.IO.Path.
                            GetFileNameWithoutExtension(
                                fullFileName
                            ).
                            ToUpperInvariant()

                                End If

                            Catch

                                actualPartName =
                        browserPartName

                            End Try


                            '================================================
                            ' CT_CLAMP_PLATE_2
                            '================================================

                            If actualPartName = "CT_CLAMP_PLATE_2" OrElse
                   browserPartName = "CT_CLAMP_PLATE_2" Then


                                '--------------------------------------------
                                ' QTY 1
                                ' SUPPRESS
                                '--------------------------------------------

                                If cbCTQtyValue.Contains("QTY1") Then

                                    If Not partOcc.Suppressed Then

                                        partOcc.Suppress()

                                    End If


                                    '--------------------------------------------
                                    ' QTY 3
                                    ' UNSUPPRESS
                                    '--------------------------------------------

                                ElseIf cbCTQtyValue.Contains("QTY3") Then

                                    If partOcc.Suppressed Then

                                        partOcc.Unsuppress()

                                    End If

                                End If


                            End If


                            '================================================
                            ' CT_CLAMP_PLATE_3
                            '================================================

                            If actualPartName = "CT_CLAMP_PLATE_3" OrElse
                   browserPartName = "CT_CLAMP_PLATE_3" Then


                                '--------------------------------------------
                                ' QTY 1
                                ' SUPPRESS
                                '--------------------------------------------

                                If cbCTQtyValue.Contains("QTY1") Then

                                    If Not partOcc.Suppressed Then

                                        partOcc.Suppress()

                                    End If


                                    '--------------------------------------------
                                    ' QTY 3
                                    ' UNSUPPRESS
                                    '--------------------------------------------

                                ElseIf cbCTQtyValue.Contains("QTY3") Then

                                    If partOcc.Suppressed Then

                                        partOcc.Unsuppress()

                                    End If

                                End If


                            End If


                        Next


                        '====================================================
                        ' UPDATE ASSEMBLIES
                        '====================================================

                        trunkAsmDoc.Update()

                        asmDoc.Update()


                    Else

                        MsgBox(
                "TRUNK_NEW_FOR_CB.iam not found."
            )

                    End If


                Else

                    MsgBox(
            "Active document is not an Assembly."
        )

                End If


            Catch ex As Exception

                MsgBox(
        "Error while updating CT Clamp Plates:" &
        vbCrLf &
        vbCrLf &
        ex.ToString()
    )

            End Try

            'TERMINATION - TRUNK INSPECTION COVER FAMILY TABLE ACTIVATION
            Try

                '============================================================
                ' GET INVENTOR APPLICATION
                '============================================================

                Dim invApp As Inventor.Application =
        CType(
            System.Runtime.InteropServices.Marshal.GetActiveObject(
                "Inventor.Application"
            ),
            Inventor.Application
        )


                '============================================================
                ' CHECK ACTIVE DOCUMENT IS ASSEMBLY
                '============================================================

                If invApp.ActiveDocumentType =
        Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then


                    Dim asmDoc As Inventor.AssemblyDocument =
            CType(
                invApp.ActiveDocument,
                Inventor.AssemblyDocument
            )

                    Dim asmDef As Inventor.AssemblyComponentDefinition =
            asmDoc.ComponentDefinition


                    '========================================================
                    ' READ INSPECTION COVER SELECTION
                    '========================================================

                    Dim inspectionCoverValue As String =
            CB_Inspec_Cover_Type.Trim().ToUpperInvariant()


                    '========================================================
                    ' MAP PSD SELECTION TO iPART FAMILY TABLE ROW
                    '
                    ' PSD-686-1  -> Row 1
                    ' PSD-686-2  -> Row 2
                    ' ...
                    ' PSD-686-12 -> Row 12
                    '========================================================

                    Dim memberRow As Integer = 0


                    Select Case inspectionCoverValue

                        Case "PSD-686-1"
                            memberRow = 1

                        Case "PSD-686-2"
                            memberRow = 2

                        Case "PSD-686-3"
                            memberRow = 3

                        Case "PSD-686-4"
                            memberRow = 4

                        Case "PSD-686-5"
                            memberRow = 5

                        Case "PSD-686-6"
                            memberRow = 6

                        Case "PSD-686-7"
                            memberRow = 7

                        Case "PSD-686-8"
                            memberRow = 8

                        Case "PSD-686-9"
                            memberRow = 9

                        Case "PSD-686-10"
                            memberRow = 10

                        Case "PSD-686-11"
                            memberRow = 11

                        Case "PSD-686-12"
                            memberRow = 12

                    End Select


                    '========================================================
                    ' CONTINUE ONLY FOR VALID SELECTION
                    '========================================================

                    If memberRow > 0 Then


                        '====================================================
                        ' FIND TRUNK_NEW_FOR_CB.iam
                        '====================================================

                        Dim trunkOccurrence As Inventor.ComponentOccurrence =
                Nothing


                        For Each occ As Inventor.ComponentOccurrence _
                In asmDef.Occurrences


                            'Example:
                            '
                            'TRUNK_NEW_FOR_CB:1
                            '
                            'becomes:
                            '
                            'TRUNK_NEW_FOR_CB

                            Dim occurrenceName As String =
                    occ.Name.Split(":"c)(0).Trim().ToUpperInvariant()


                            If occurrenceName = "TRUNK_NEW_FOR_CB" OrElse
                   occurrenceName = "TRUNK_NEW_FOR_CB.IAM" Then

                                trunkOccurrence = occ

                                Exit For

                            End If


                        Next


                        '====================================================
                        ' TRUNK ASSEMBLY FOUND
                        '====================================================

                        If trunkOccurrence IsNot Nothing Then


                            '------------------------------------------------
                            ' Make sure TRUNK assembly is active
                            '------------------------------------------------

                            If trunkOccurrence.Suppressed Then

                                trunkOccurrence.Unsuppress()

                            End If


                            '================================================
                            ' GET TRUNK ASSEMBLY DOCUMENT
                            '================================================

                            Dim trunkAsmDoc As Inventor.AssemblyDocument =
                    CType(
                        trunkOccurrence.Definition.Document,
                        Inventor.AssemblyDocument
                    )


                            Dim trunkAsmDef As Inventor.AssemblyComponentDefinition =
                    trunkAsmDoc.ComponentDefinition


                            '================================================
                            ' FIND CURRENT INSPECTION COVER iPART MEMBERS
                            '
                            ' Browser can contain:
                            '
                            ' INSPECTION_COVER_686-01:1
                            ' INSPECTION_COVER_686-01:2
                            '
                            ' or:
                            '
                            ' INSPECTION_COVER_686-02:1
                            ' INSPECTION_COVER_686-03:1
                            ' ...
                            ' INSPECTION_COVER_686-12:1
                            '
                            ' We need to identify whichever member is
                            ' currently active.
                            '================================================

                            Dim inspectionCoverFound As Boolean = False


                            For Each partOcc As Inventor.ComponentOccurrence _
                    In trunkAsmDef.Occurrences


                                '------------------------------------------------
                                ' Remove Inventor occurrence number
                                '
                                ' INSPECTION_COVER_686-01:1
                                '
                                ' becomes:
                                '
                                ' INSPECTION_COVER_686-01
                                '------------------------------------------------

                                Dim partName As String =
                        partOcc.Name.Split(":"c)(0).Trim().ToUpperInvariant()


                                '------------------------------------------------
                                ' Remove .IPT also if Inventor shows extension
                                '------------------------------------------------

                                If partName.EndsWith(".IPT") Then

                                    partName =
                            partName.Substring(
                                0,
                                partName.Length - 4
                            )

                                End If


                                '================================================
                                ' CHECK FAMILY MEMBER NAMES 01 TO 12
                                '================================================

                                Dim isInspectionCoverMember As Boolean = False


                                For rowNo As Integer = 1 To 12


                                    Dim familyMemberName As String =
                            "INSPECTION_COVER_686-" &
                            rowNo.ToString("00")


                                    If partName = familyMemberName Then

                                        isInspectionCoverMember = True

                                        Exit For

                                    End If


                                Next


                                '================================================
                                ' CURRENT OCCURRENCE IS INSPECTION COVER iPART
                                '================================================

                                If isInspectionCoverMember Then


                                    inspectionCoverFound = True


                                    '------------------------------------------------
                                    ' Unsuppress if currently suppressed
                                    '------------------------------------------------

                                    If partOcc.Suppressed Then

                                        partOcc.Unsuppress()

                                    End If


                                    '================================================
                                    ' CHECK iPART MEMBER
                                    '================================================

                                    If partOcc.IsiPartMember Then


                                        '================================================
                                        ' CHANGE FAMILY TABLE ROW
                                        '
                                        ' PSD-686-1  -> Row 1
                                        ' PSD-686-2  -> Row 2
                                        ' ...
                                        ' PSD-686-12 -> Row 12
                                        '
                                        ' IMPORTANT:
                                        ' Do not Exit For here because your assembly
                                        ' contains multiple occurrences such as:
                                        '
                                        ' INSPECTION_COVER_686-01:1
                                        ' INSPECTION_COVER_686-01:2
                                        '
                                        ' Both must change.
                                        '================================================

                                        partOcc.ChangeRowOfiPartMember(
                                memberRow
                            )


                                    Else

                                        MsgBox(
                                partOcc.Name &
                                " is not an iPart member."
                            )

                                    End If


                                End If


                            Next


                            '================================================
                            ' UPDATE ASSEMBLY
                            '================================================

                            If inspectionCoverFound Then

                                trunkAsmDoc.Update()

                                asmDoc.Update()

                            Else

                                MsgBox(
                        "Inspection Cover iPart member was not found." &
                        vbCrLf &
                        vbCrLf &
                        "Expected member names:" &
                        vbCrLf &
                        "INSPECTION_COVER_686-01 to " &
                        "INSPECTION_COVER_686-12"
                    )

                            End If


                        Else

                            MsgBox(
                    "TRUNK_NEW_FOR_CB.iam was not found " &
                    "inside the active assembly."
                )

                        End If


                    Else

                        MsgBox(
                "Invalid Inspection Cover selection: " & CB_Inspec_Cover_Type)


                    End If


                Else

                    MsgBox(
            "Active document is not an Assembly."
        )

                End If


            Catch ex As Exception

                MsgBox(
        "Error while changing Inspection Cover iPart:" &
        vbCrLf &
        vbCrLf &
        ex.ToString()
    )

            End Try

            'TERMINATION - DC INSPECTION COVER FAMILY TABLE ACTIVATION
            Dim dcFamilyAsmDoc As Inventor.AssemblyDocument = Nothing
            Dim dcFamilyOpenedByCode As Boolean = False

            Try

                '============================================================
                ' GET INVENTOR APPLICATION
                '============================================================

                Dim invApp As Inventor.Application =
        CType(
            System.Runtime.InteropServices.Marshal.GetActiveObject(
                "Inventor.Application"
            ),
            Inventor.Application
        )


                '============================================================
                ' GET CB TYPE
                '
                ' SIDE -> LV_DC.iam
                ' TOP  -> DC_TOP.iam
                '============================================================

                Dim cbTypeValue As String =
        CB_Type.Trim().
        ToUpperInvariant()


                '============================================================
                ' GET INSPECTION COVER SELECTION
                '
                ' Examples:
                '
                ' PSD-686-1
                ' PSD-686-2
                ' ...
                ' PSD-686-12
                '============================================================

                Dim inspectionCoverValue As String =
        DC_Inspec_Cover.Trim().
        ToUpperInvariant()


                '============================================================
                ' GET ROW NUMBER FROM SELECTION
                '============================================================

                Dim rowNo As Integer = 0


                If inspectionCoverValue.StartsWith(
        "PSD-686-"
    ) Then

                    Dim rowText As String =
            inspectionCoverValue.Substring(
                "PSD-686-".Length
            ).Trim()

                    Integer.TryParse(
            rowText,
            rowNo
        )

                End If


                '============================================================
                ' VALID ROWS
                '
                ' PSD-686-1  -> 01
                ' PSD-686-2  -> 02
                ' ...
                ' PSD-686-12 -> 12
                '============================================================

                If rowNo >= 1 AndAlso
       rowNo <= 12 Then


                    '========================================================
                    ' IPART MEMBER NAME
                    '
                    ' IMPORTANT:
                    '
                    ' Even for CB_Type = TOP, the family member names are:
                    '
                    ' INSPECTION_COVER_686-01
                    ' INSPECTION_COVER_686-02
                    ' ...
                    ' INSPECTION_COVER_686-12
                    '========================================================

                    Dim familyMemberName As String =
            "INSPECTION_COVER_686-" &
            rowNo.ToString("00")


                    '========================================================
                    ' ASSEMBLY PATH
                    '========================================================

                    Dim dcAssemblyPath As String = ""


                    '========================================================
                    ' CB TYPE = SIDE
                    '
                    ' LV_DISCONNECTING_CHAMBER\LV_DC.iam
                    '========================================================

                    If cbTypeValue = "SIDE" Then

                        dcAssemblyPath =
                System.IO.Path.Combine(
                    directoryPath,
                    "LV_DISCONNECTING_CHAMBER",
                    "LV_DC.iam"
                )


                        '========================================================
                        ' CB TYPE = TOP
                        '
                        ' DC(TOP_VARIANT)\DC_TOP.iam
                        '========================================================

                    ElseIf cbTypeValue = "TOP" Then

                        dcAssemblyPath =
                System.IO.Path.Combine(
                    directoryPath,
                    "DC(TOP_VARIANT)",
                    "DC_TOP.iam"
                )

                    End If


                    '========================================================
                    ' CHECK ASSEMBLY PATH
                    '========================================================

                    If dcAssemblyPath <> "" Then


                        If System.IO.File.Exists(
                dcAssemblyPath
            ) Then


                            '================================================
                            ' CHECK WHETHER ASSEMBLY IS ALREADY OPEN
                            '================================================

                            For Each openDoc As Inventor.Document _
                    In invApp.Documents

                                Try

                                    If String.Equals(
                            openDoc.FullFileName,
                            dcAssemblyPath,
                            StringComparison.OrdinalIgnoreCase
                        ) Then

                                        If openDoc.DocumentType =
                                Inventor.DocumentTypeEnum.
                                kAssemblyDocumentObject Then

                                            dcFamilyAsmDoc =
                                    CType(
                                        openDoc,
                                        Inventor.AssemblyDocument
                                    )

                                        End If

                                        Exit For

                                    End If

                                Catch

                                End Try

                            Next


                            '================================================
                            ' OPEN DC ASSEMBLY INVISIBLE
                            '================================================

                            If dcFamilyAsmDoc Is Nothing Then

                                dcFamilyAsmDoc =
                        CType(
                            invApp.Documents.Open(
                                dcAssemblyPath,
                                False
                            ),
                            Inventor.AssemblyDocument
                        )

                                dcFamilyOpenedByCode = True

                            End If


                            '================================================
                            ' ASSEMBLY OPENED
                            '================================================

                            If dcFamilyAsmDoc IsNot Nothing Then


                                Dim dcFamilyAsmDef As _
                        Inventor.AssemblyComponentDefinition =
                        dcFamilyAsmDoc.ComponentDefinition


                                Dim inspectionCoverFound As Boolean =
                        False

                                Dim inspectionCoverChanged As Boolean =
                        False


                                '================================================
                                ' LOOP THROUGH NATIVE OCCURRENCES
                                '
                                ' DO NOT EXIT AFTER FIRST MATCH.
                                '
                                ' There can be:
                                '
                                ' INSPECTION_COVER_DC:1
                                ' INSPECTION_COVER_DC:2
                                ' INSPECTION_COVER_DC:3
                                '
                                ' All must change.
                                '================================================

                                For Each inspectionOcc As _
                        Inventor.ComponentOccurrence _
                        In dcFamilyAsmDef.Occurrences


                                    '--------------------------------------------
                                    ' BROWSER NAME
                                    '
                                    ' Example:
                                    '
                                    ' INSPECTION_COVER_DC:1
                                    '
                                    ' becomes:
                                    '
                                    ' INSPECTION_COVER_DC
                                    '--------------------------------------------

                                    Dim baseName As String =
                            inspectionOcc.Name.
                            Split(":"c)(0).
                            Trim().
                            ToUpperInvariant()


                                    '--------------------------------------------
                                    ' ACTUAL REFERENCED FILE NAME
                                    '--------------------------------------------

                                    Dim actualFileName As String = ""


                                    Try

                                        actualFileName =
                                System.IO.Path.
                                GetFileNameWithoutExtension(
                                    inspectionOcc.
                                    Definition.
                                    Document.
                                    FullFileName
                                ).
                                Trim().
                                ToUpperInvariant()

                                    Catch

                                        actualFileName = ""

                                    End Try


                                    '================================================
                                    ' CB TYPE = SIDE
                                    '
                                    ' EXISTING CONDITION REMAINS:
                                    '
                                    ' Occurrence/member name:
                                    '
                                    ' INSPECTION_COVER_686-01
                                    ' INSPECTION_COVER_686-02
                                    ' ...
                                    ' INSPECTION_COVER_686-12
                                    '================================================

                                    If cbTypeValue = "SIDE" Then


                                        If baseName.StartsWith(
                                "INSPECTION_COVER_686-"
                            ) OrElse
                               actualFileName.StartsWith(
                                "INSPECTION_COVER_686-"
                            ) Then


                                            inspectionCoverFound =
                                    True


                                            '----------------------------------------
                                            ' UNSUPPRESS BEFORE CHANGING ROW
                                            '----------------------------------------

                                            If inspectionOcc.Suppressed Then

                                                inspectionOcc.Unsuppress()

                                            End If


                                            '----------------------------------------
                                            ' CHANGE IPART MEMBER
                                            '
                                            ' Example:
                                            '
                                            ' INSPECTION_COVER_686-05
                                            '----------------------------------------

                                            If inspectionOcc.IsiPartMember Then

                                                inspectionOcc.
                                        ChangeRowOfiPartMember(
                                            familyMemberName
                                        )

                                                inspectionCoverChanged =
                                        True

                                            End If


                                        End If


                                        '================================================
                                        ' CB TYPE = TOP
                                        '
                                        ' IMPORTANT CHANGE
                                        '
                                        ' Inside DC_TOP.iam the browser occurrences are:
                                        '
                                        ' INSPECTION_COVER_DC:1
                                        ' INSPECTION_COVER_DC:2
                                        ' INSPECTION_COVER_DC:3
                                        '
                                        ' Therefore find occurrence using:
                                        '
                                        ' INSPECTION_COVER_DC
                                        '
                                        ' BUT activate iPart member using:
                                        '
                                        ' INSPECTION_COVER_686-xx
                                        '================================================

                                    ElseIf cbTypeValue = "TOP" Then


                                        If baseName =
                                "INSPECTION_COVER_DC" OrElse
                               baseName =
                                "INSPECTION_COVER_DC.IPT" OrElse
                               actualFileName =
                                "INSPECTION_COVER_DC" Then


                                            inspectionCoverFound =
                                    True


                                            '----------------------------------------
                                            ' UNSUPPRESS BEFORE CHANGING ROW
                                            '----------------------------------------

                                            If inspectionOcc.Suppressed Then

                                                inspectionOcc.Unsuppress()

                                            End If


                                            '----------------------------------------
                                            ' CHANGE IPART MEMBER
                                            '
                                            ' Browser occurrence:
                                            '
                                            ' INSPECTION_COVER_DC:1
                                            '
                                            ' Family member to activate:
                                            '
                                            ' INSPECTION_COVER_686-01
                                            ' INSPECTION_COVER_686-02
                                            ' ...
                                            '----------------------------------------

                                            If inspectionOcc.IsiPartMember Then

                                                inspectionOcc.
                                        ChangeRowOfiPartMember(
                                            familyMemberName
                                        )

                                                inspectionCoverChanged =
                                        True

                                            End If


                                        End If


                                    End If


                                Next


                                '================================================
                                ' UPDATE ASSEMBLY
                                '================================================

                                If inspectionCoverChanged Then

                                    dcFamilyAsmDoc.Update()

                                End If


                                '================================================
                                ' SAVE ASSEMBLY IF THIS CODE OPENED IT
                                '
                                ' Since ChangeRowOfiPartMember modifies the assembly,
                                ' we must save before closing.
                                '================================================

                                If dcFamilyOpenedByCode Then

                                    dcFamilyAsmDoc.Save()

                                End If


                                '================================================
                                ' OPTIONAL ERROR MESSAGES
                                '================================================

                                If Not inspectionCoverFound Then

                                    If cbTypeValue = "SIDE" Then

                                        MsgBox(
                                "Inspection cover occurrence was not found " &
                                "inside LV_DC.iam." &
                                vbCrLf &
                                vbCrLf &
                                "Expected occurrence family: " &
                                "INSPECTION_COVER_686-xx"
                            )

                                    ElseIf cbTypeValue = "TOP" Then

                                        MsgBox(
                                "INSPECTION_COVER_DC was not found " &
                                "inside DC_TOP.iam."
                            )

                                    End If


                                ElseIf Not inspectionCoverChanged Then

                                    MsgBox(
                            "Inspection cover was found, but it is not " &
                            "recognized as an iPart member." &
                            vbCrLf &
                            vbCrLf &
                            "Requested member: " &
                            familyMemberName
                        )

                                End If


                            End If


                            '================================================
                            ' CLOSE ONLY IF THIS CODE OPENED THE ASSEMBLY
                            '================================================

                            If dcFamilyOpenedByCode AndAlso
                   dcFamilyAsmDoc IsNot Nothing Then

                                dcFamilyAsmDoc.Close(
                        True
                    )

                                dcFamilyAsmDoc = Nothing

                                dcFamilyOpenedByCode = False

                            End If


                        Else

                            MsgBox(
                    "DC assembly was not found:" &
                    vbCrLf &
                    dcAssemblyPath
                )

                        End If


                    Else

                        MsgBox(
                "Invalid CB_Type value: " &
                CB_Type
            )

                    End If


                Else

                    MsgBox(
            "Invalid DC inspection cover selection:" &
            vbCrLf &
            DC_Inspec_Cover &
            vbCrLf &
            vbCrLf &
            "Expected PSD-686-1 to PSD-686-12."
        )

                End If


            Catch ex As Exception

                MsgBox(
        "Error while activating DC inspection cover family:" &
        vbCrLf &
        vbCrLf &
        ex.ToString()
    )

            Finally

                '============================================================
                ' SAFETY CLOSE
                '============================================================

                Try

                    If dcFamilyOpenedByCode AndAlso
           dcFamilyAsmDoc IsNot Nothing Then

                        dcFamilyAsmDoc.Close(
                True
            )

                    End If

                Catch

                End Try

            End Try

            'TERMINATION - HOLES CONDITION - TRUNK DC CABLE BOX
            Try

                '============================================================
                ' GET INVENTOR APPLICATION
                '============================================================

                Dim invApp As Inventor.Application =
        Main_Panel.ThisApplication


                '============================================================
                ' MAIN ASSEMBLY
                '============================================================

                If invApp.ActiveDocument IsNot Nothing AndAlso
       invApp.ActiveDocument.DocumentType =
       Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then

                    Dim mainAsmDoc As Inventor.AssemblyDocument =
            CType(
                invApp.ActiveDocument,
                Inventor.AssemblyDocument
            )

                    Dim mainAsmDef As Inventor.AssemblyComponentDefinition =
            mainAsmDoc.ComponentDefinition


                    '========================================================
                    ' CB TYPE
                    '========================================================

                    Dim cbTypeValue As String =
            CB_Type.Trim().ToUpperInvariant()

                    Dim frontInspectionCoverTypeValue As String =
            CB_Front_Inspec_Cover.Trim().ToUpperInvariant()

                    Dim glandPositionValue As String =
            CB_Gland_POS.Trim().ToUpperInvariant()
                    '========================================================
                    ' COMMON HOLE CALCULATION
                    '
                    ' Pitch = 25 x Sqrt(14)
                    '       = 93.5 mm
                    '
                    ' Hole Count = Round((Dimension - 40) / Pitch)
                    '========================================================

                    Dim referencePitch As Double =
            Math.Round(
                25.0 * Math.Sqrt(14.0),
                1
            )


                    '========================================================
                    ' STORED CALCULATION VALUES
                    '========================================================

                    Dim trunkD33Pitch As Double = 0.0
                    Dim trunkD33Count As Integer = 0
                    Dim trunkD33Calculated As Boolean = False

                    Dim trunkD32Pitch As Double = 0.0
                    Dim trunkD32Count As Integer = 0
                    Dim trunkD32Calculated As Boolean = False

                    Dim sideDcD124Pitch As Double = 0.0
                    Dim sideDcD124Count As Integer = 0
                    Dim sideDcD124Calculated As Boolean = False

                    Dim sideDcD123Pitch As Double = 0.0
                    Dim sideDcD123Count As Integer = 0
                    Dim sideDcD123Calculated As Boolean = False

                    Dim sideDcD119Pitch As Double = 0.0
                    Dim sideDcD119Count As Integer = 0
                    Dim sideDcD119Calculated As Boolean = False

                    Dim sideDcD118Pitch As Double = 0.0
                    Dim sideDcD118Count As Integer = 0
                    Dim sideDcD118Calculated As Boolean = False

                    Dim topDcD57Pitch As Double = 0.0
                    Dim topDcD57Count As Integer = 0
                    Dim topDcD57Calculated As Boolean = False

                    Dim topDcD56Pitch As Double = 0.0
                    Dim topDcD56Count As Integer = 0
                    Dim topDcD56Calculated As Boolean = False

                    Dim topDcD33Pitch As Double = 0.0
                    Dim topDcD33Count As Integer = 0
                    Dim topDcD33Calculated As Boolean = False

                    Dim topDcD32Pitch As Double = 0.0
                    Dim topDcD32Count As Integer = 0
                    Dim topDcD32Calculated As Boolean = False

                    Dim cableD124Pitch As Double = 0.0
                    Dim cableD124Count As Integer = 0
                    Dim cableD124Calculated As Boolean = False

                    Dim cableD123Pitch As Double = 0.0
                    Dim cableD123Count As Integer = 0
                    Dim cableD123Calculated As Boolean = False

                    Dim cableD260Pitch As Double = 0.0
                    Dim cableD260Count As Integer = 0
                    Dim cableD260Calculated As Boolean = False

                    Dim cableD259Pitch As Double = 0.0
                    Dim cableD259Count As Integer = 0
                    Dim cableD259Calculated As Boolean = False

                    Dim cableD262Pitch As Double = 0.0
                    Dim cableD262Count As Integer = 0
                    Dim cableD262Calculated As Boolean = False

                    Dim cableD261Pitch As Double = 0.0
                    Dim cableD261Count As Integer = 0
                    Dim cableD261Calculated As Boolean = False

                    Dim cableD264Pitch As Double = 0.0
                    Dim cableD264Count As Integer = 0
                    Dim cableD264Calculated As Boolean = False

                    Dim cableD263Pitch As Double = 0.0
                    Dim cableD263Count As Integer = 0
                    Dim cableD263Calculated As Boolean = False

                    Dim glandD374Pitch As Double = 0.0
                    Dim glandD374Count As Integer = 0
                    Dim glandD374Calculated As Boolean = False

                    Dim glandD375Pitch As Double = 0.0
                    Dim glandD375Count As Integer = 0
                    Dim glandD375Calculated As Boolean = False

                    Dim glandD368Pitch As Double = 0.0
                    Dim glandD368Count As Integer = 0
                    Dim glandD368Calculated As Boolean = False

                    Dim glandD369Pitch As Double = 0.0
                    Dim glandD369Count As Integer = 0
                    Dim glandD369Calculated As Boolean = False

                    Dim glandD370Pitch As Double = 0.0
                    Dim glandD370Count As Integer = 0
                    Dim glandD370Calculated As Boolean = False

                    Dim glandD371Pitch As Double = 0.0
                    Dim glandD371Count As Integer = 0
                    Dim glandD371Calculated As Boolean = False

                    Dim glandD373Pitch As Double = 0.0
                    Dim glandD373Count As Integer = 0
                    Dim glandD373Calculated As Boolean = False

                    Dim glandD372Pitch As Double = 0.0
                    Dim glandD372Count As Integer = 0
                    Dim glandD372Calculated As Boolean = False


                    '********************************************************
                    ' TRUNK
                    '********************************************************

                    Dim trunkOccurrence As Inventor.ComponentOccurrence = Nothing

                    For Each occ As Inventor.ComponentOccurrence _
            In mainAsmDef.Occurrences

                        Dim browserName As String =
                occ.Name.Split(":"c)(0).
                Trim().
                ToUpperInvariant()

                        Dim actualName As String = ""

                        Try

                            actualName =
                    System.IO.Path.
                    GetFileNameWithoutExtension(
                        occ.Definition.Document.FullFileName
                    ).
                    ToUpperInvariant()

                        Catch

                            actualName = ""

                        End Try

                        If browserName = "TRUNK_NEW_FOR_CB" OrElse
               browserName = "TRUNK_NEW_FOR_CB.IAM" OrElse
               actualName = "TRUNK_NEW_FOR_CB" Then

                            trunkOccurrence = occ

                            Exit For

                        End If

                    Next


                    If trunkOccurrence IsNot Nothing Then

                        Dim trunkAsmDoc As Inventor.AssemblyDocument = Nothing

                        Try

                            trunkAsmDoc =
                    CType(
                        trunkOccurrence.Definition.Document,
                        Inventor.AssemblyDocument
                    )

                        Catch

                            trunkAsmDoc = Nothing

                        End Try


                        If trunkAsmDoc IsNot Nothing Then

                            Dim trunkAsmDef As Inventor.AssemblyComponentDefinition =
                    trunkAsmDoc.ComponentDefinition

                            Dim bottomFlangeTrunkOcc As Inventor.ComponentOccurrence =
                    Nothing


                            For Each occ As Inventor.ComponentOccurrence _
                    In trunkAsmDef.Occurrences

                                Dim browserName As String =
                        occ.Name.Split(":"c)(0).
                        Trim().
                        ToUpperInvariant()

                                Dim actualName As String = ""

                                Try

                                    actualName =
                            System.IO.Path.
                            GetFileNameWithoutExtension(
                                occ.Definition.Document.FullFileName
                            ).
                            ToUpperInvariant()

                                Catch

                                    actualName = ""

                                End Try


                                If browserName = "BOTTOM_FLANGE_TRUNK" OrElse
                       browserName = "BOTTOM_FLANGE_TRUNK.IPT" OrElse
                       actualName = "BOTTOM_FLANGE_TRUNK" Then

                                    bottomFlangeTrunkOcc = occ

                                    Exit For

                                End If

                            Next


                            If bottomFlangeTrunkOcc IsNot Nothing Then

                                Dim trunkPartDoc As Inventor.PartDocument = Nothing

                                Try

                                    trunkPartDoc =
                            CType(
                                bottomFlangeTrunkOcc.Definition.Document,
                                Inventor.PartDocument
                            )

                                Catch

                                    trunkPartDoc = Nothing

                                End Try


                                If trunkPartDoc IsNot Nothing Then

                                    Dim trunkPartDef As Inventor.PartComponentDefinition =
                            trunkPartDoc.ComponentDefinition

                                    Dim extrusion1 As Inventor.ExtrudeFeature =
                            Nothing

                                    Dim sketch1 As Inventor.PlanarSketch =
                            Nothing


                                    Try

                                        extrusion1 =
                                trunkPartDef.Features.
                                ExtrudeFeatures.
                                Item("Extrusion1")

                                    Catch

                                        extrusion1 = Nothing

                                    End Try


                                    Try

                                        sketch1 =
                                trunkPartDef.Sketches.Item(
                                    "Sketch1"
                                )

                                    Catch

                                        sketch1 = Nothing

                                    End Try


                                    If extrusion1 IsNot Nothing AndAlso
                           sketch1 IsNot Nothing Then

                                        Dim d32Parameter As Inventor.Parameter =
                                Nothing

                                        Dim d33Parameter As Inventor.Parameter =
                                Nothing


                                        For Each dimConstraint As _
                                Inventor.DimensionConstraint _
                                In sketch1.DimensionConstraints

                                            If dimConstraint.Parameter IsNot Nothing Then

                                                Dim parameterName As String =
                                        dimConstraint.Parameter.Name.
                                        Trim().
                                        ToUpperInvariant()

                                                If parameterName = "D32" Then

                                                    d32Parameter =
                                            dimConstraint.Parameter

                                                ElseIf parameterName = "D33" Then

                                                    d33Parameter =
                                            dimConstraint.Parameter

                                                End If

                                            End If

                                        Next


                                        If d32Parameter IsNot Nothing Then

                                            Dim valueMM As Double =
                                    trunkPartDoc.UnitsOfMeasure.
                                    ConvertUnits(
                                        d32Parameter.Value,
                                        Inventor.UnitsTypeEnum.
                                        kDatabaseLengthUnits,
                                        Inventor.UnitsTypeEnum.
                                        kMillimeterLengthUnits
                                    )

                                            Dim usableDistance As Double =
                                    valueMM - 40.0

                                            If usableDistance > 0 Then

                                                Dim rawHoleCount As Double =
                                                    usableDistance /
                                                    referencePitch

                                                Dim holeCount As Integer =
                                                    CInt(
                                                        Math.Round(
                                                            rawHoleCount,
                                                            0,
                                                            MidpointRounding.AwayFromZero
                                                        )
                                                    )

                                                If holeCount > 0 Then

                                                    trunkD32Pitch =
                                            referencePitch

                                                    trunkD32Count =
                                            holeCount

                                                    trunkD32Calculated =
                                            True

                                                End If

                                            End If

                                        End If


                                        If d33Parameter IsNot Nothing Then

                                            Dim valueMM As Double =
                                    trunkPartDoc.UnitsOfMeasure.
                                    ConvertUnits(
                                        d33Parameter.Value,
                                        Inventor.UnitsTypeEnum.
                                        kDatabaseLengthUnits,
                                        Inventor.UnitsTypeEnum.
                                        kMillimeterLengthUnits
                                    )

                                            Dim usableDistance As Double =
                                    valueMM - 40.0

                                            If usableDistance > 0 Then

                                                Dim rawHoleCount As Double =
                                                    usableDistance /
                                                    referencePitch

                                                Dim holeCount As Integer =
                                                    CInt(
                                                        Math.Round(
                                                            rawHoleCount,
                                                            0,
                                                            MidpointRounding.AwayFromZero
                                                        )
                                                    )

                                                If holeCount > 0 Then

                                                    trunkD33Pitch =
                                            referencePitch

                                                    trunkD33Count =
                                            holeCount

                                                    trunkD33Calculated =
                                            True

                                                End If

                                            End If

                                        End If

                                    End If

                                End If

                            End If

                        End If

                    End If


                    '********************************************************
                    ' DC - SIDE
                    '********************************************************

                    If cbTypeValue = "SIDE" Then

                        Dim lvDcOccurrence As Inventor.ComponentOccurrence =
                Nothing


                        For Each occ As Inventor.ComponentOccurrence _
                In mainAsmDef.Occurrences

                            Dim browserName As String =
                    occ.Name.Split(":"c)(0).
                    Trim().
                    ToUpperInvariant()

                            Dim actualName As String = ""

                            Try

                                actualName =
                        System.IO.Path.
                        GetFileNameWithoutExtension(
                            occ.Definition.Document.FullFileName
                        ).
                        ToUpperInvariant()

                            Catch

                                actualName = ""

                            End Try


                            If browserName = "LV_DC" OrElse
                   browserName = "LV_DC.IAM" OrElse
                   actualName = "LV_DC" Then

                                lvDcOccurrence = occ

                                Exit For

                            End If

                        Next


                        If lvDcOccurrence IsNot Nothing Then

                            Dim lvDcAsmDoc As Inventor.AssemblyDocument =
                    Nothing

                            Try

                                lvDcAsmDoc =
                        CType(
                            lvDcOccurrence.Definition.Document,
                            Inventor.AssemblyDocument
                        )

                            Catch

                                lvDcAsmDoc = Nothing

                            End Try


                            If lvDcAsmDoc IsNot Nothing Then

                                Dim lvDcAsmDef As _
                        Inventor.AssemblyComponentDefinition =
                        lvDcAsmDoc.ComponentDefinition


                                '================================================
                                ' CABLE_BOX_MATCHING_FLANGE.ipt
                                '================================================

                                Dim cableBoxMatchingOcc As _
                        Inventor.ComponentOccurrence =
                        Nothing


                                For Each occ As Inventor.ComponentOccurrence _
                        In lvDcAsmDef.Occurrences

                                    Dim browserName As String =
                            occ.Name.Split(":"c)(0).
                            Trim().
                            ToUpperInvariant()

                                    Dim actualName As String = ""

                                    Try

                                        actualName =
                                System.IO.Path.
                                GetFileNameWithoutExtension(
                                    occ.Definition.Document.FullFileName
                                ).
                                ToUpperInvariant()

                                    Catch

                                        actualName = ""

                                    End Try


                                    If browserName =
                           "CABLE_BOX_MATCHING_FLANGE" OrElse
                           browserName =
                           "CABLE_BOX_MATCHING_FLANGE.IPT" OrElse
                           actualName =
                           "CABLE_BOX_MATCHING_FLANGE" Then

                                        cableBoxMatchingOcc = occ

                                        Exit For

                                    End If

                                Next


                                If cableBoxMatchingOcc IsNot Nothing Then

                                    Dim sourcePartDoc As Inventor.PartDocument =
                            Nothing

                                    Try

                                        sourcePartDoc =
                                CType(
                                    cableBoxMatchingOcc.
                                    Definition.Document,
                                    Inventor.PartDocument
                                )

                                    Catch

                                        sourcePartDoc = Nothing

                                    End Try


                                    If sourcePartDoc IsNot Nothing Then

                                        Dim sourcePartDef As _
                                Inventor.PartComponentDefinition =
                                sourcePartDoc.ComponentDefinition

                                        Dim extrusion1 As Inventor.ExtrudeFeature =
                                Nothing

                                        Dim sketch1 As Inventor.PlanarSketch =
                                Nothing


                                        Try

                                            extrusion1 =
                                    sourcePartDef.Features.
                                    ExtrudeFeatures.
                                    Item("Extrusion1")

                                        Catch

                                            extrusion1 = Nothing

                                        End Try


                                        Try

                                            sketch1 =
                                    sourcePartDef.Sketches.Item(
