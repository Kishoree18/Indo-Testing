                        If drawName <> "UNDER_BASE_ASSEMBLY_OLTC_RIGHT.IDW" Then
                            Exit Try
                        End If

                        'If Not drawName.Equals("COOLER_BANK_ASSEMBLY.idw", StringComparison.OrdinalIgnoreCase) Then
                        '    Exit Sub
                        'End If

