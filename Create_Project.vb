                                For Each feat As ExtrudeFeature In partDef.Features.ExtrudeFeatures
                                    Dim featName As String = ""
                                    Try
                                        featName = feat.Name
                                    Catch
                                        Continue For
                                    End Try

                                    For Each targetFeat In extrusionsToDelete
