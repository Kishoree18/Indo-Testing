                            Dim title = mainPL.PartsListColumns.Item(i).Title.Trim.ToUpper()

                            If title = "DESCRIPTION" Then descCol = i
                            If title = "QTY" Then qtyCol = i
                            If title = "IT" Then itCol = i
                        Next

                        If descCol = -1 Or qtyCol = -1 Or itCol = -1 Then Exit Try


