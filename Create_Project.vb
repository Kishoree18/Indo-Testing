            End If

            If Directory.Exists(workOrderFolder) Then


                Dim fileCount As Integer = Directory.GetFiles(workOrderFolder, "*.*", SearchOption.AllDirectories).Length

                ' === If folder has more than 2 files (shared templates already there) ===
                If fileCount > 2 Then
                    ' Define protected items
                    Dim protectedIpj As String = System.IO.Path.Combine(workOrderFolder, workOrderNo & ".ipj")
                    Dim protectedFolder As String = System.IO.Path.Combine(workOrderFolder, "OldVersions")
                    Dim protectedBak As String = System.IO.Path.Combine(protectedFolder, workOrderNo & ".ipj.bak")

                    ' Delete everything except the protected items
                    For Each item As String In Directory.GetFileSystemEntries(workOrderFolder, "*", SearchOption.TopDirectoryOnly)
                        Try
                            ' Skip the protected IPJ file
                            If String.Equals(item, protectedIpj, StringComparison.OrdinalIgnoreCase) Then Continue For

                            ' Skip the OldVersions folder and its .bak file
                            If String.Equals(item, protectedFolder, StringComparison.OrdinalIgnoreCase) Then Continue For
                            If item.StartsWith(protectedFolder & "\", StringComparison.OrdinalIgnoreCase) Then Continue For

                            ' Delete file or folder
                            If System.IO.File.Exists(item) Then
                                System.IO.File.Delete(item)
                            ElseIf Directory.Exists(item) Then
                                Directory.Delete(item, True)
                            End If

                        Catch ex As Exception
                            MsgBox("Could not delete item: " & item & " -> " & ex.Message)
                        End Try
                    Next
                End If

                ' ====== COPY ALL FILES + SUBFOLDERS FROM SOURCE (EXCEPT ONE FILE) ======
                Dim sourceDir As New DirectoryInfo(sourcePath)
                Dim targetDir As New DirectoryInfo(workOrderFolder)
                Dim dirs As New Stack(Of DirectoryInfo)
                dirs.Push(sourceDir)

                Do While dirs.Count > 0
                    Dim currentSource As DirectoryInfo = dirs.Pop()
                    Dim relativePath As String = currentSource.FullName.Substring(sourceDir.FullName.Length).TrimStart("\"c)
                    Dim currentTargetPath As String = System.IO.Path.Combine(targetDir.FullName, relativePath)

                    Directory.CreateDirectory(currentTargetPath)

                    ' Copy files except the excluded one and the active assembly file
                    For Each f As FileInfo In currentSource.GetFiles()
                        Dim destFile As String = System.IO.Path.Combine(currentTargetPath, f.Name)
                        f.CopyTo(destFile, True)
                    Next

                    ' Push subdirectories for recursive traversal
                    For Each subDir As DirectoryInfo In currentSource.GetDirectories()
                        dirs.Push(subDir)
                    Next
                Loop


            Else

                Directory.CreateDirectory(workOrderFolder)

                ' ====== COPY ALL FILES + SUBFOLDERS FROM SOURCE (EXCEPT ONE FILE) ======
                Dim sourceDir As New DirectoryInfo(sourcePath)
                Dim targetDir As New DirectoryInfo(workOrderFolder)
                Dim dirs As New Stack(Of DirectoryInfo)
                dirs.Push(sourceDir)

                Do While dirs.Count > 0
                    Dim currentSource As DirectoryInfo = dirs.Pop()
                    Dim relativePath As String = currentSource.FullName.Substring(sourceDir.FullName.Length).TrimStart("\"c)
                    Dim currentTargetPath As String = System.IO.Path.Combine(targetDir.FullName, relativePath)

                    Directory.CreateDirectory(currentTargetPath)

                    ' Copy files except the excluded one and the active assembly file
                    For Each f As FileInfo In currentSource.GetFiles()
                        Dim destFile As String = System.IO.Path.Combine(currentTargetPath, f.Name)
                        f.CopyTo(destFile, True)
                    Next

                    ' Push subdirectories for recursive traversal
                    For Each subDir As DirectoryInfo In currentSource.GetDirectories()
                        dirs.Push(subDir)
                    Next
                Loop

