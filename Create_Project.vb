                                    v.Scale = 1 / 30

                                    If viewName = "HV_FRONT_VIEW" Then
                                        v.Center = oTG.CreatePoint2d(16.5, 25.0)
                                    Else
                                        v.Center = oTG.CreatePoint2d(15, 14.5)
                                    End If

                                    v.Suppressed = False
                                Catch ex As Exception
                                    MsgBox("Error aligning " & viewName & ": " & ex.Message)
                                End Try
                            End If
                        Next
                    Next

                    ' ---------- CONDITIONAL VIEW SUPPRESSION ----------
                    If fileName.Trim().ToUpper() = "BOTTOM_TANK_ASSEMBLY_OLTC_RIGHT.IDW" Then
                        For Each s As Sheet In drwDoc.Sheets
                            For Each v As DrawingView In s.DrawingViews
                                v.Suppressed = False
                                Dim viewName As String = v.Name.Trim().ToUpper()

                                If earthingHV = "TYPE 1" Or earthingLV = "TYPE 1" Then
                                    If viewName = "VIEW22" Then v.Suppressed = True
                                End If

                                If earthingHV = "TYPE 2" Or earthingLV = "TYPE 2" Then
                                    If viewName = "VIEW21" Then v.Suppressed = True
