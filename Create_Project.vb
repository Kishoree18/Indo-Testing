                        ' 3. Access the Layers collection
                        Dim layersCol As LayersEnumerator = drawingDoc.StylesManager.Layers

                        ' 4. Define a Helper Sub to safely update visibility
                        ' This prevents the code from crashing if a layer is missing from the template
                        Dim SetLyr As Action(Of String, Boolean) =
