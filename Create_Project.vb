                                                filePath,
                                                StringComparison.OrdinalIgnoreCase
                                            ) Then

                                                                    If openDoc.DocumentType =
                                                   Inventor.DocumentTypeEnum.
                                                   kPartDocumentObject Then

                                                                        bottomTankPartDoc =
                                                        CType(
                                                            openDoc,
                                                            Inventor.PartDocument
                                                        )

                                                                    End If

                                                                    Exit For

                                                                End If

                                                            Catch

                                                            End Try

                                                        Next


                                                        '================================
                                                        ' OPEN INVISIBLE
                                                        '================================

                                                        If bottomTankPartDoc Is Nothing Then

                                                            bottomTankPartDoc =
                                            TryCast(
                                                invApp.Documents.Open(
                                                    filePath,
                                                    False
