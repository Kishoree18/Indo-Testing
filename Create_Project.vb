    Private Sub CollectAllOccurrences(
    occs As ComponentOccurrences,
    cache As Dictionary(Of String, List(Of ComponentOccurrence)))

        For Each occ As ComponentOccurrence In occs

            If occ.Suppressed Then Continue For

            Dim fileName As String =
            IO.Path.GetFileName(occ.Definition.Document.FullFileName).ToUpper()

            If Not cache.ContainsKey(fileName) Then
                cache.Add(fileName, New List(Of ComponentOccurrence))
            End If

            cache(fileName).Add(occ)

            ' ⭐ recursive into subassemblies
            If occ.SubOccurrences.Count > 0 Then
                CollectAllOccurrences(occ.SubOccurrences, cache)
            End If

        Next
    End Sub


    Friend Sub AddBallonToFilteredView_T(
    View As DrawingView,
    AllowedFiles As List(Of String))

        If View Is Nothing Then Exit Sub

        Dim bomSheet As Sheet = View.Parent.Parent.Sheets.Item(3)
        If bomSheet.PartsLists.Count = 0 Then Exit Sub

        Dim PartsList As PartsList = bomSheet.PartsLists.Item(1)

        InitialiseViewBoundingBox(View)

        '---------------------------------------
        ' OCCURRENCE CACHE (RECURSIVE - SAFE)
        '---------------------------------------
        Dim viewOccCache As New Dictionary(Of String, List(Of ComponentOccurrence))

        Dim asmDoc As AssemblyDocument =
        CType(View.ReferencedDocumentDescriptor.ReferencedDocument, AssemblyDocument)

        CollectAllOccurrences(asmDoc.ComponentDefinition.Occurrences, viewOccCache)


        '---------------------------------------
        ' CURVE CACHE
        '---------------------------------------
        Dim curveCache As New Dictionary(Of String, List(Of DrawingCurve))


        '---------------------------------------
        ' PROCESS BOM ROWS
        '---------------------------------------
        For Each row As PartsListRow In PartsList.PartsListRows

            ' ⭐ skip hidden rows
            If Not row.Visible Then Continue For

            If row.Ballooned Then Continue For
            If row.ReferencedFiles.Count = 0 Then Continue For

            Dim docName As String =
            IO.Path.GetFileName(row.ReferencedFiles.Item(1).FullFileName).ToUpper()

            ' filter by your allowed list
            If Not AllowedFiles.Any(Function(x) x.ToUpper() = docName) Then Continue For

            ' skip if no occurrences found
            If Not viewOccCache.ContainsKey(docName) Then Continue For

            ' cache curves once
            If Not curveCache.ContainsKey(docName) Then
                curveCache(docName) = GetCurvesFromOcc(viewOccCache(docName), View)
            End If

            CreateRowItemBalloon(row, View, curveCache(docName))

        Next


        '---------------------------------------
        ' ARRANGE BALLOONS
        '---------------------------------------
        ArrangeBalloonsOnView(View)

    End Sub

