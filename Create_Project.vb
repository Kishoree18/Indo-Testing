    Private Sub HideFromListRecursive(parentOcc As ComponentOccurrence,
                                  hideList As List(Of String))

        Dim children As ComponentOccurrences = Nothing

        Try
            children = parentOcc.SubOccurrences
        Catch
            Exit Sub
        End Try

        For Each subOcc As ComponentOccurrence In children

            Dim pure As String = ""

            Try
                pure = System.IO.Path.GetFileNameWithoutExtension(
                       subOcc.Definition.Document.DisplayName).ToUpper()
            Catch
                pure = subOcc.Name.Split(":"c)(0).ToUpper()
            End Try


            If hideList.Contains(pure) Then

                ' hide graphics
                subOcc.Visible = False

                ' hide virtual/phantom/BOM items
                Try
                    subOcc.Excluded = True
                Catch
                End Try

            End If

            HideFromListRecursive(subOcc, hideList)

        Next

    End Sub




