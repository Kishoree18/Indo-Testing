                        ' GET ACTIVE MAIN ASSEMBLY
                        '============================================================

                        Dim mainAsmDoc As Inventor.AssemblyDocument =
        TryCast(
            invApp.ActiveDocument,
            Inventor.AssemblyDocument
        )


                        If mainAsmDoc IsNot Nothing Then

                            Dim mainAsmDef As Inventor.AssemblyComponentDefinition =
            mainAsmDoc.ComponentDefinition


                            '========================================================
                            ' VARIABLES TO STORE SOURCE VALUES
                            '========================================================

                            Dim d196ValueMM As Double =
            0.0

                            Dim d197ValueDegree As Double =
            0.0

                            Dim d397ValueMM As Double =
            0.0


                            Dim d196Found As Boolean =
            False

                            Dim d197Found As Boolean =
            False

                            Dim d397Found As Boolean =
            False


                            '========================================================
                            ' FIND CONSERVATOR.iam
                            ' INSIDE ACTIVE MAIN ASSEMBLY
                            '========================================================

                            Dim conservatorOcc As Inventor.ComponentOccurrence =
            Nothing


                            For Each occ As Inventor.ComponentOccurrence _
            In mainAsmDef.Occurrences

                                Dim browserName As String =
                occ.Name.
                Split(":"c)(0).
                Trim().
                ToUpperInvariant()


                                Dim actualFileName As String =
                ""


                                Try

                                    actualFileName =
                    System.IO.Path.
                    GetFileNameWithoutExtension(
                        occ.ReferencedDocumentDescriptor.
                            FullDocumentName
                    ).
                    Trim().
                    ToUpperInvariant()

                                Catch

                                    actualFileName =
                    ""

                                End Try


                                If browserName = "CONSERVATOR" OrElse
               browserName = "CONSERVATOR.IAM" OrElse
               actualFileName = "CONSERVATOR" Then

                                    conservatorOcc =
                    occ

                                    Exit For

                                End If

                            Next


                            '========================================================
                            ' CONSERVATOR FOUND
                            '========================================================

                            If conservatorOcc IsNot Nothing Then

                                Dim conservatorAsmDoc As Inventor.AssemblyDocument =
                Nothing


                                Try

                                    conservatorAsmDoc =
                    TryCast(
                        conservatorOcc.Definition.Document,
                        Inventor.AssemblyDocument
                    )

                                Catch

                                    conservatorAsmDoc =
                    Nothing

                                End Try


                                If conservatorAsmDoc IsNot Nothing Then

                                    Dim conservatorAsmDef As Inventor.AssemblyComponentDefinition =
                    conservatorAsmDoc.ComponentDefinition


                                    '================================================
                                    ' FIND NEW_BREATHER_FLANGE_PIPE.ipt
                                    ' INSIDE CONSERVATOR.iam
                                    '================================================

                                    Dim breatherPipeOcc As Inventor.ComponentOccurrence =
                    Nothing


                                    For Each partOcc As Inventor.ComponentOccurrence _
                    In conservatorAsmDef.Occurrences

                                        Dim partBrowserName As String =
                        partOcc.Name.
                        Split(":"c)(0).
                        Trim().
                        ToUpperInvariant()


                                        Dim partActualName As String =
                        ""


                                        Try

                                            partActualName =
                            System.IO.Path.
                            GetFileNameWithoutExtension(
                                partOcc.ReferencedDocumentDescriptor.
                                    FullDocumentName
                            ).
                            Trim().
                            ToUpperInvariant()

                                        Catch

                                            partActualName =
                            ""

                                        End Try


                                        If partBrowserName =
                       "NEW_BREATHER_FLANGE_PIPE" OrElse
                       partBrowserName =
                       "NEW_BREATHER_FLANGE_PIPE.IPT" OrElse
                       partActualName =
                       "NEW_BREATHER_FLANGE_PIPE" Then

                                            breatherPipeOcc =
                            partOcc

                                            Exit For

                                        End If

                                    Next


                                    '================================================
                                    ' NEW_BREATHER_FLANGE_PIPE FOUND
                                    '================================================

                                    If breatherPipeOcc IsNot Nothing Then

                                        Dim breatherPartDoc As Inventor.PartDocument =
                        Nothing


                                        Try

                                            breatherPartDoc =
                            TryCast(
                                breatherPipeOcc.Definition.Document,
                                Inventor.PartDocument
                            )

                                        Catch

                                            breatherPartDoc =
                            Nothing

                                        End Try


                                        If breatherPartDoc IsNot Nothing Then

                                            Dim breatherPartDef As Inventor.PartComponentDefinition =
                            breatherPartDoc.ComponentDefinition


                                            '============================================
                                            ' FIND Sketch42
                                            '============================================

                                            Dim sketch42 As Inventor.PlanarSketch =
                            Nothing


                                            For Each sk As Inventor.PlanarSketch _
                            In breatherPartDef.Sketches

                                                If sk.Name.
                                Trim().
                                ToUpperInvariant() =
                                "SKETCH42" Then

                                                    sketch42 =
                                    sk

                                                    Exit For

                                                End If

                                            Next


                                            '============================================
                                            ' Sketch42 FOUND
                                            '============================================

                                            If sketch42 IsNot Nothing Then

                                                Dim d196Parameter As Inventor.Parameter =
                                Nothing

                                                Dim d197Parameter As Inventor.Parameter =
                                Nothing

                                                Dim d397Parameter As Inventor.Parameter =
                                Nothing


                                                '========================================
                                                ' FIND d196, d197 AND d397
                                                ' INSIDE Sketch42
                                                '========================================

                                                For Each dimConstraint As Inventor.DimensionConstraint _
                                In sketch42.DimensionConstraints

                                                    Try

                                                        If dimConstraint.Parameter IsNot Nothing Then

                                                            Dim sourceParameterName As String =
                                            dimConstraint.Parameter.Name.
                                            Trim().
                                            ToUpperInvariant()


                                                            If sourceParameterName = "D196" Then

                                                                d196Parameter =
                                                dimConstraint.Parameter


                                                            ElseIf sourceParameterName = "D197" Then

                                                                d197Parameter =
                                                dimConstraint.Parameter


                                                            ElseIf sourceParameterName = "D397" Then

                                                                d397Parameter =
                                                dimConstraint.Parameter

                                                            End If

                                                        End If

                                                    Catch

                                                    End Try

                                                Next


                                                '========================================
                                                ' GET d196 VALUE
                                                '
                                                ' INVENTOR INTERNAL LENGTH = cm
                                                ' CONVERT cm -> mm
                                                '
                                                ' TARGET = TT_ITT_1194
                                                '========================================

                                                If d196Parameter IsNot Nothing Then

                                                    d196ValueMM =
                                    CDbl(
                                        d196Parameter.Value
                                    ) * 10.0

                                                    d196Found =
                                    True

                                                Else

                                                    MsgBox(
                                    "d196 was not found inside Sketch42."
                                )

                                                End If


                                                '========================================
                                                ' GET d197 VALUE
                                                '
                                                ' INVENTOR INTERNAL ANGLE = radians
                                                ' CONVERT radians -> degrees
                                                '
                                                ' TARGET = TT_ITT_1195
                                                '========================================

                                                If d197Parameter IsNot Nothing Then

                                                    d197ValueDegree =
                                    CDbl(
                                        d197Parameter.Value
                                    ) *
                                    (180.0 / Math.PI)

                                                    d197Found =
                                    True

                                                Else

                                                    MsgBox(
                                    "d197 was not found inside Sketch42."
                                )

                                                End If


                                                '========================================
                                                ' GET d397 VALUE
                                                '
                                                ' INVENTOR INTERNAL LENGTH = cm
                                                ' CONVERT cm -> mm
                                                '
                                                ' TARGET = TT_ITT_1198
                                                '========================================

                                                If d397Parameter IsNot Nothing Then

                                                    d397ValueMM =
                                    CDbl(
                                        d397Parameter.Value
                                    ) * 10.0

                                                    d397Found =
                                    True

                                                Else

                                                    MsgBox(
                                    "d397 was not found inside Sketch42."
                                )

                                                End If


