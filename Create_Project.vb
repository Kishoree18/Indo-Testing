                ' Example: a Yes/No choice from your form
                Dim requireSubAssembly As Boolean = (MPS_REQ = "Yes")

                ' The name of the sub-assembly you want to control
                Dim targetSubAssemblyName As String = "MONOGRAM_FIXING_PLATE" ' without .iam extension

                For Each occ As ComponentOccurrence In compDef.Occurrences
                    Dim baseName As String = occ.Name.Split(":"c)(0).Trim()
                    baseName = baseName.Replace(".iam", "").Trim()

                    If baseName.Equals(targetSubAssemblyName, StringComparison.OrdinalIgnoreCase) Then
