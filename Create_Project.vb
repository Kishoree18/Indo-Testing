    }

                        '-----------------------------------------------------------
                        ' STEP A: HIDE BOM ROWS (Searching ALL Sheets)
                        '-----------------------------------------------------------
                        Dim bomMatchCount As Integer = 0
                        For Each oSheet As Sheet In drawDoc.Sheets
                            For Each oPL As PartsList In oSheet.PartsLists
                                For i As Integer = oPL.PartsListRows.Count To 1 Step -1
                                    Dim row As PartsListRow = oPL.PartsListRows.Item(i)
                                    Try
                                        If row.ReferencedFiles IsNot Nothing AndAlso row.ReferencedFiles.Count > 0 Then
                                            Dim fileName2 As String = System.IO.Path.GetFileName(row.ReferencedFiles.Item(1).FullFileName)

                                            ' Clean versioning (part.ipt.1 -> part.ipt)
                                            If fileName2.Contains(".ipt.") Or fileName2.Contains(".iam.") Then
                                                fileName2 = fileName2.Substring(0, fileName2.LastIndexOf("."))
                                            End If

                                            If hideList.Contains(fileName2) Then
                                                row.Visible = False
                                                bomMatchCount += 1
                                            End If
                                        End If
                                    Catch : Continue For : End Try
                                Next
                            Next
                        Next

                        '-----------------------------------------------------------
                        ' STEP B: HIDE IN DRAWING VIEWS
                        '-----------------------------------------------------------
                        Dim totalViewMatchCount As Integer = 0
                        Dim diagnosticName As String = ""

                        For Each oSheet As Sheet In drawDoc.Sheets
                            For Each dView As DrawingView In oSheet.DrawingViews

                                ' Break Design View Associativity so we can hide things
                                Try
                                    dView.DesignViewRepresentationAssociative = False
                                Catch : End Try

                                ' Get the top-level assembly in the view
                                Dim refDoc As Document = dView.ReferencedDocumentDescriptor.ReferencedDocument
                                If refDoc.DocumentType <> DocumentTypeEnum.kAssemblyDocumentObject Then Continue For

                                Dim asmDoc As AssemblyDocument = CType(refDoc, AssemblyDocument)

                                ' Use AllLeafOccurrences to get every single Part (IPT) at every level
                                For Each occ As ComponentOccurrence In asmDoc.ComponentDefinition.Occurrences.AllLeafOccurrences
                                    Try
                                        Dim occFullFileName As String = occ.Definition.Document.FullFileName
                                        Dim occFileName As String = System.IO.Path.GetFileName(occFullFileName)

                                        ' Capture the first filename we see for diagnostic purposes
                                        If diagnosticName = "" Then diagnosticName = occFileName

                                        ' Clean versioning
                                        If occFileName.Contains(".ipt.") Or occFileName.Contains(".iam.") Then
                                            occFileName = occFileName.Substring(0, occFileName.LastIndexOf("."))
                                        End If

                                        ' Check if this part (or its parent assembly) should be hidden
                                        Dim shouldHide As Boolean = False

                                        ' Check the part itself
                                        If hideList.Contains(occFileName) Then
                                            shouldHide = True
                                        Else
                                            ' Check parent assemblies (Climb the tree to see if an owner IAM is in the hide list)
                                            Dim parentOcc As ComponentOccurrence = occ.ParentOccurrence
                                            Do While parentOcc IsNot Nothing
                                                Dim pName As String = System.IO.Path.GetFileName(parentOcc.Definition.Document.FullFileName)
                                                If pName.Contains(".iam.") Then pName = pName.Substring(0, pName.LastIndexOf("."))

                                                If hideList.Contains(pName) Then
                                                    shouldHide = True
                                                    Exit Do
                                                End If
                                                parentOcc = parentOcc.ParentOccurrence
                                            Loop
                                        End If

                                        If shouldHide Then
                                            dView.SetVisibility(occ, False)
                                            totalViewMatchCount += 1
                                        End If
                                    Catch : End Try
                                Next
                            Next
