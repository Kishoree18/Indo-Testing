    Friend Sub AddBallonToFilteredView_Bottom(View As DrawingView, AllowedFiles As List(Of String))
        Try
            Dim oPL As PartsList = View.Parent.PartsLists.Item(1)
            InitialiseViewBoundingBox(View)

            Dim allowedClean As New HashSet(Of String)
            For Each f In AllowedFiles : allowedClean.Add(f.ToUpper().Replace(" ", "").Replace("_", "").Trim()) : Next

            Dim fileToRowMap As New Dictionary(Of String, PartsListRow)
            For Each row As PartsListRow In oPL.PartsListRows
                'Resetting check: Always look at visible rows regardless of cached Ballooned status
                If row.Visible Then
                    Dim fn = System.IO.Path.GetFileName(row.ReferencedFiles.Item(1).FullFileName).ToUpper().Trim()
                    Dim fnClean = fn.Replace(" ", "").Replace("_", "")
                    If Not fileToRowMap.ContainsKey(fnClean) Then fileToRowMap.Add(fnClean, row)
                End If
            Next

            Dim foundPart1 As Boolean = False
            Dim foundPart2 As Boolean = False
            Dim placedPart1 As Boolean = False
            Dim placedPart2 As Boolean = False

            Dim isPart1Allowed As Boolean = AllowedFiles.Any(Function(x) x.ToUpper().Contains("BT_SIDE_PLATE_STIFFENR_OLTC_1"))
            Dim isPart2Allowed As Boolean = AllowedFiles.Any(Function(x) x.ToUpper().Contains("PROB_SUPPORT_PLATE"))

            Dim curvesInView As DrawingCurvesEnumerator = View.DrawingCurves()
            Dim processedFilesForThisView As New HashSet(Of String)

            For Each oCurve As DrawingCurve In curvesInView
                If oCurve Is Nothing Then Continue For

                Dim oOcc As ComponentOccurrence = oCurve.ModelGeometry.ContainingOccurrence
                If oOcc Is Nothing Then Continue For

                Dim currentOcc As ComponentOccurrence = oOcc
                Do While currentOcc IsNot Nothing
                    Dim occFileName As String = System.IO.Path.GetFileName(currentOcc.Definition.Document.FullFileName).ToUpper().Trim()
                    Dim occFileClean As String = occFileName.Replace(" ", "").Replace("_", "")

                    'Detection Logic
                    If occFileClean.Contains("BTSIDEPLATESTIFFENROLTC1") Then foundPart1 = True
                    If occFileClean.Contains("PROB_SUPPORT_PLATE") Then foundPart2 = True

                    If allowedClean.Contains(occFileClean) AndAlso Not processedFilesForThisView.Contains(occFileClean) Then
                        If fileToRowMap.ContainsKey(occFileClean) Then
                            Dim targetRow As PartsListRow = fileToRowMap(occFileClean)

                            Try
                                'Attempt placement
                                CreateRowItemBalloon(targetRow, View, New List(Of DrawingCurve) From {oCurve})
                                processedFilesForThisView.Add(occFileClean)

                                'Tracking Success
                                If occFileClean.Contains("BTSIDEPLATESTIFFENROLTC1") Then placedPart1 = True
                                If occFileClean.Contains("PROB_SUPPORT_PLATE") Then placedPart2 = True
                            Catch
                                'If placement Then fails, we DON'T add to processedFiles, 
                                'so the loop tries the NEXT line it finds for this part.
                            End Try
                        End If
                    End If
                    currentOcc = currentOcc.ParentOccurrence
                Loop
            Next

            '--- FINAL ALERTS ---

            'If isPart2Allowed Then
            '    If Not foundPart2 Then
            '        MsgBox("Alert [" & View.Name & "]: PROB_SUPPORT_PLATE NOT detected in geometry.")
            '    ElseIf foundPart2 And Not placedPart2 Then
            '        MsgBox("Alert [" & View.Name & "]: PROB_SUPPORT_PLATE detected, but Balloon placement failed on all edges.")
            '    End If
            'End If

            ArrangeBalloonsOnView(View)
        Catch : End Try
    End Sub

