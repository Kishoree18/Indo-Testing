    Public Sub workorder()

        Try

            Dim query As String = "SELECT wk_odr_No FROM Create_Project"

            Using conn As New SqlConnection(Main_Panel.connectionString)
                Using cmd As New SqlCommand(query, conn)
                    Try
                        conn.Open()

                        Using reader As SqlDataReader = cmd.ExecuteReader()

                            workorder_list.Items.Clear()

                            workorder_list.Items.Add("0000")

                            While reader.Read()
                                Dim wkNo As String = reader("wk_odr_No").ToString()

                                If wkNo <> "0000" Then
                                    workorder_list.Items.Add(wkNo)
                                End If
                            End While
                        End Using

                        workorder_list.SelectedItem = "0000"

                    Catch ex As Exception
                        MessageBox.Show("Error loading work orders: " & ex.Message)
                    End Try
                End Using
            End Using

        Catch ex As Exception
            MessageBox.Show("Error: " & ex.Message)
        End Try

    End Sub

