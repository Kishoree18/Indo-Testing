    Sub HV_turret_dia_U(parameters As Parameters)
        ' Base reference values in mm
        Dim BaseTurretDia As Double = 756
        Dim BasePipeSize As Double = 170

        Try
            ' Get current turret dia from 101 + 103 and convert to mm
            Dim para101 As Double = parameters.Item("TT_ITT_0101").Value * 10
            Dim para103 As Double = parameters.Item("TT_ITT_0103").Value * 10

            Dim CurrentTurretDia As Double = para101 + para103

            ' Calculate new pipe size
            Dim newPipeSize As Double = BasePipeSize - (CurrentTurretDia - BaseTurretDia)

            ' Prevent negative pipe height
            If newPipeSize < 0 Then newPipeSize = 0

            ' Update the pipe height parameter
            Try
                parameters.Item("TT_ITT_0924").Expression = newPipeSize.ToString()
            Catch ex As Exception
                MsgBox("Parameter 'Pipe_Height' not found. Cannot update pipe size.", MsgBoxStyle.Exclamation)
            End Try

        Catch ex As Exception
            MsgBox("Required parameter TT_ITT_0101 or TT_ITT_0103 not found!", MsgBoxStyle.Exclamation)
        End Try
    End Sub


    Sub HV_turret_dia_W(parameters As Parameters)
        ' Base reference values
        Dim BaseTurretDia As Double = 756
        Dim BasePipeSize As Double = 170

        Try
            ' Get current turret dia from only these two parameters
            Dim para101 As Double = parameters.Item("TT_ITT_0171").Value * 10
            Dim para103 As Double = parameters.Item("TT_ITT_0173").Value * 10

            Dim CurrentTurretDia As Double = para101 + para103

            ' Calculate new pipe size
            Dim newPipeSize As Double = BasePipeSize - (CurrentTurretDia - BaseTurretDia)

            ' Update the pipe height parameter if it exists
            Try
                parameters.Item("TT_ITT_0925").Expression = newPipeSize.ToString()
            Catch ex As Exception
                ' Parameter Pipe_Height not found
                MsgBox("Parameter 'Pipe_Height' not found. Cannot update pipe size.", MsgBoxStyle.Exclamation)
            End Try

        Catch ex As Exception
            ' One of the required parameters not found
            MsgBox("Required parameter TT_ITT_0101 or TT_ITT_0103 not found!", MsgBoxStyle.Exclamation)
        End Try
    End Sub

    Private Function SafeNumber(value As Object) As String
        If value Is DBNull.Value OrElse value Is Nothing OrElse value.ToString().Trim() = "" Then
            Return "0"
        End If
        Return value.ToString()
    End Function


