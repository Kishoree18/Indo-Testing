                                MsgBox(
                "CONSERVATOR.iam was not found " &
                "inside the active assembly."
            )

                            End If


                        Else

                            MsgBox(
            "Please open the main assembly document."
        )

                        End If


                    Catch ex As Exception

                        MsgBox(
        "Error while updating Breather Flange Pipe parameters:" &
        vbCrLf &
        vbCrLf &
        ex.ToString()
    )

                    End Try

                    'TYING_FLAT_CB_1X100.ipt SUPPRESS
                    Try

                        '============================================================
                        ' CONNECT TO INVENTOR
                        '============================================================

                        ThisApplication =
        Marshal.GetActiveObject("Inventor.Application")


                        '============================================================
                        ' GET ACTIVE ASSEMBLY
                        '============================================================

                        Dim mainAsmDoc As Inventor.AssemblyDocument =
        TryCast(
            ThisApplication.ActiveDocument,
            Inventor.AssemblyDocument
        )


                        If mainAsmDoc IsNot Nothing Then

                            Dim mainAsmDef As Inventor.AssemblyComponentDefinition =
            mainAsmDoc.ComponentDefinition


                            Dim tyingFlat1x100Found As Boolean =
            False

                            Dim tyingFlatFound As Boolean =
            False


                            '========================================================
                            ' LOOP THROUGH ACTIVE ASSEMBLY OCCURRENCES
                            '========================================================

                            For Each comp As Inventor.ComponentOccurrence _
            In mainAsmDef.Occurrences


                                Dim browserName As String =
                comp.Name.
                Split(":"c)(0).
                Trim().
                ToUpperInvariant()


                                Dim actualFileName As String =
                ""


                                Try

                                    actualFileName =
                    System.IO.Path.
                    GetFileNameWithoutExtension(
                        comp.ReferencedDocumentDescriptor.
                            FullDocumentName
                    ).
                    Trim().
                    ToUpperInvariant()

                                Catch

                                    actualFileName =
                    ""

                                End Try


                                '====================================================
                                ' TYING_FLAT_CB_1X100.ipt
                                '
                                ' SUPPRESS
                                '====================================================

                                If browserName = "TYING_FLAT_CB_1X100" OrElse
               browserName = "TYING_FLAT_CB_1X100.IPT" OrElse
               actualFileName = "TYING_FLAT_CB_1X100" Then


                                    tyingFlat1x100Found =
                    True


                                    If Not comp.Suppressed Then

                                        comp.Suppress()

                                    End If

                                End If


                                '====================================================
                                ' TYING_FLAT_CB.ipt
                                '
                                ' UNSUPPRESS
                                '====================================================

                                If browserName = "TYING_FLAT_CB" OrElse
               browserName = "TYING_FLAT_CB.IPT" OrElse
               actualFileName = "TYING_FLAT_CB" Then


                                    tyingFlatFound =
                    True


                                    If comp.Suppressed Then

                                        comp.Unsuppress()

                                    End If

                                End If

                            Next


                            '========================================================
                            ' UPDATE ACTIVE ASSEMBLY
                            '========================================================

                            mainAsmDoc.Update()


                            '========================================================
                            ' OPTIONAL NOT-FOUND ALERTS
                            '========================================================

                            If Not tyingFlat1x100Found Then

                                MsgBox(
                "TYING_FLAT_CB_1X100.ipt was not found " &
                "inside the active assembly."
            )

                            End If


                            If Not tyingFlatFound Then

                                MsgBox(
                "TYING_FLAT_CB.ipt was not found " &
                "inside the active assembly."
            )

                            End If


                        Else

                            MsgBox(
            "Please open the main assembly document."
        )

                        End If


                    Catch ex As Exception

                        MsgBox(
        "Error while changing TYING FLAT suppression:" &
        vbCrLf &
        vbCrLf &
        ex.ToString()
    )

                    End Try

                    'BOM UPDATE
                    Try

                        Dim invApp As Inventor.Application = ThisApplication

                        Dim paramFile As String = System.IO.Path.Combine(directoryPath, "BOTTOM_TANK_PARAMETER.ipt")
                        Dim paramPart As Inventor.PartDocument = Nothing

                        If System.IO.File.Exists(paramFile) Then
                            paramPart = CType(invApp.Documents.Open(paramFile, True), Inventor.PartDocument)
                        Else
                            MsgBox("Error: Parameter file not found: " & paramFile)
                            Exit Sub
                        End If

                        Dim parameters As Inventor.Parameters = paramPart.ComponentDefinition.Parameters

                        Dim TT_ITT_0501 As String = parameters.Item("TT_ITT_0501").Expression.Replace("mm", "").Trim()
                        Dim TT_ITT_0661 As String = parameters.Item("TT_ITT_0661").Expression.Replace("mm", "").Trim()
                        Dim TT_ITT_0660 As String = parameters.Item("TT_ITT_0660").Expression.Replace("mm", "").Trim()


                        paramPart.Close(True)

                        Dim A_HEADER_SPACE As String = "20 THK x " & TT_ITT_0660 & " x " & TT_ITT_0661 & " Sq. (REFER DETAILS)"
                        Dim TOP_HEADER_PIPE As String = TT_ITT_0501 & " NB, REFER DETAILS"
                        Dim TOP_COOLER_PIPE_HV_SIDE As String = TT_ITT_0501 & " NB, REFER DETAILS"
                        Dim TOP_COOLER_PIPE_LV_SIDE As String = TT_ITT_0501 & " NB, REFER DETAILS"
                        Dim BOTTOM_COOLER_PIPE_HV_SIDE As String = TT_ITT_0501 & " NB, REFER DETAILS"
                        Dim BOTTOM_COOLER_PIPE_LV_SIDE As String = TT_ITT_0501 & " NB, REFER DETAILS"

                        Dim partsValueMap As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)
                        partsValueMap.Add(NormalizeName("A_HEADER BASE.ipt"), A_HEADER_SPACE)
                        partsValueMap.Add(NormalizeName("TOP_HEADER_PIPE.ipt"), TOP_HEADER_PIPE)
                        partsValueMap.Add(NormalizeName("TOP_COOLER_PIPE_HV_SIDE.ipt"), TOP_COOLER_PIPE_HV_SIDE)
                        partsValueMap.Add(NormalizeName("TOP_COOLER_PIPE_LV_SIDE.ipt"), TOP_COOLER_PIPE_LV_SIDE)
                        partsValueMap.Add(NormalizeName("BOTTOM_COOLER_PIPE_HV_SIDE.ipt"), BOTTOM_COOLER_PIPE_HV_SIDE)
                        partsValueMap.Add(NormalizeName("BOTTOM_COOLER_PIPE_LV_SIDE.ipt"), BOTTOM_COOLER_PIPE_LV_SIDE)

                        Dim asmDoc As AssemblyDocument = CType(invApp.ActiveDocument, AssemblyDocument)

                        asmDoc.Update2(True)
                        invApp.UserInterfaceManager.DoEvents()

                        For Each occ As Inventor.ComponentOccurrence In asmDoc.ComponentDefinition.Occurrences

                            Dim stack As New Stack(Of Inventor.ComponentOccurrence)
                            stack.Push(occ)

                            While stack.Count > 0

                                Dim currentOcc = stack.Pop()

                                If currentOcc.Suppressed Then Continue While

                                If currentOcc.DefinitionDocumentType = Inventor.DocumentTypeEnum.kPartDocumentObject Then

                                    Dim partDoc As Inventor.PartDocument = CType(currentOcc.Definition.Document, Inventor.PartDocument)

                                    Dim fileName As String = System.IO.Path.GetFileName(partDoc.FullFileName)
                                    Dim normalizedOccName As String = NormalizeName(fileName)

                                    If partsValueMap.ContainsKey(normalizedOccName) Then

                                        Dim newVal As String = partsValueMap(normalizedOccName)

                                        Dim trans As Inventor.Transaction = invApp.TransactionManager.StartTransaction(partDoc, "Update iProperties")

                                        Try
                                            Dim props As Inventor.PropertySet = Nothing
                                            For Each ps As Inventor.PropertySet In partDoc.PropertySets
                                                If ps.Name = "Inventor User Defined Properties" Then
                                                    props = ps
                                                    Exit For
                                                End If
                                            Next
                                            If props Is Nothing Then props = partDoc.PropertySets.Add("Inventor User Defined Properties")

                                            Try
                                                props.Item("DRG/SIZE/DIMENSION").Value = newVal
                                            Catch
                                                props.Add(newVal, "DRG/SIZE/DIMENSION")
                                            End Try

                                            partDoc.Update()
                                            partDoc.Save()

                                            trans.End()

                                        Catch ex As Exception
                                            trans.Abort()
                                            MsgBox("Failed on: " & partDoc.DisplayName & vbCrLf & ex.Message)
                                        End Try

                                    End If

                                ElseIf currentOcc.DefinitionDocumentType = Inventor.DocumentTypeEnum.kAssemblyDocumentObject Then

                                    Dim subAsm As Inventor.AssemblyDocument = CType(currentOcc.Definition.Document, Inventor.AssemblyDocument)
                                    For Each child As Inventor.ComponentOccurrence In subAsm.ComponentDefinition.Occurrences
                                        stack.Push(child)
                                    Next

                                End If

                            End While
                        Next

                    Catch ex As Exception
                        MsgBox("Error iproperties: " & ex.ToString())
                    End Try

                    'SAVE
                    Try
                        Dim invApp As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
                        Dim asmDoc As AssemblyDocument = CType(invApp.ActiveDocument, AssemblyDocument)

                        Dim basePath As String = "C:\Indotech\Projects"
                        Dim workOrderNo As String = wk_odr_No.Text.Trim()
                        Dim workOrderFolder As String = System.IO.Path.Combine(basePath, workOrderNo)
                        'Dim bottomTankFolder As String = System.IO.Path.Combine(workOrderFolder, "Cooler Bank Output")

                        ' Make sure folder exists
                        If Not System.IO.Directory.Exists(workOrderFolder) Then
                            System.IO.Directory.CreateDirectory(workOrderFolder)
                        End If

                        Dim fileName As String = System.IO.Path.GetFileName(asmDoc.FullFileName)
                        Dim savePath As String = System.IO.Path.Combine(workOrderFolder, fileName)

                        ' Safety check for file type
                        If Not System.IO.Path.GetExtension(savePath).ToLower().Equals(".iam") Then
                            savePath &= ".iam"
                        End If

                        ' Save logic
                        If asmDoc.FullFileName.ToLower() = savePath.ToLower() Then
                            asmDoc.Save()
                        Else
                            asmDoc.SaveAs(savePath, True)
                        End If

                        'MsgBox("Assembly saved successfully to: " & savePath)

                    Catch ex As Exception
                        MsgBox("Error save: " & ex.Message)
                    End Try

                    ProgressBar1.Value = 100

                    MsgBox("Cooler_Bank Completed!!")

                End If

            End If


        Catch ex As Exception

        End Try





    End Sub


