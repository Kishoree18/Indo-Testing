    Private Function NormalizeName(name As String) As String
        name = name.ToUpper().Trim()
        name = name.Replace(".IPT", "").Replace(".IAM", "")
        If name.Contains(":") Then name = name.Split(":"c)(0)
        Return name
    End Function



