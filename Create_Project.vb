    Private Sub AddOrReplace(propSet As Inventor.PropertySet, propName As String, propValue As Object)
        Try
            Dim prop As Inventor.Property = propSet.Item(propName)
            prop.Value = propValue
        Catch
            Try
                propSet.Add(propValue, propName)
            Catch ex As Exception
                MsgBox("Error adding property: " & propName & vbCrLf & ex.Message)
            End Try
        End Try
    End Sub

    Private Sub Button5_Click(sender As Object, e As EventArgs) Handles Button5.Click

        Dim existingWorkOrderAtStart As Boolean = False
        Dim replaceExistingModels As Boolean = False
        Dim shouldCopyModels As Boolean = True

        'EXISTING WORKING CODE
        Try

            '---------------------------------
            ' Step 1: Connect to Inventor
            '---------------------------------
            Dim invApp As Inventor.Application = Nothing
            Try
                invApp = Marshal.GetActiveObject("Inventor.Application")
            Catch ex As Exception
                MsgBox("Inventor not running. Please start Inventor first!", MsgBoxStyle.Critical, "Error")
                Exit Sub
            End Try

            Dim projMgr As DesignProjectManager = invApp.DesignProjectManager

            '---------------------------------
            ' Step 2: Prepare project name & paths
            '---------------------------------
            Dim rawWorkOrder As String = wk_odr_No.Text.Trim()
            If String.IsNullOrWhiteSpace(rawWorkOrder) Then
                MsgBox("Work order number is empty. Provide a valid value.", MsgBoxStyle.Exclamation, "Input required")
                Exit Sub
            End If

            ' Clean up invalid characters
            Dim safeWorkOrder As String = rawWorkOrder
            For Each ch As Char In System.IO.Path.GetInvalidFileNameChars()
                safeWorkOrder = safeWorkOrder.Replace(ch, "_"c)
            Next
            safeWorkOrder = safeWorkOrder.Replace(" "c, "_"c)

            Dim basePath As String = "C:\Indotech\Projects"
            Dim workOrderFolder As String = System.IO.Path.Combine(basePath, safeWorkOrder)
            Dim projectFilePath As String = System.IO.Path.Combine(workOrderFolder, safeWorkOrder & ".ipj")

            ' Ensure folders exist
            If Not Directory.Exists(basePath) Then Directory.CreateDirectory(basePath)
            If Not Directory.Exists(workOrderFolder) Then Directory.CreateDirectory(workOrderFolder)

            '---------------------------------
            ' Step 3: Switch to Default project before creation
            '---------------------------------
            Try
                Dim defaultProj As DesignProject = Nothing
                For Each proj As DesignProject In projMgr.DesignProjects
                    If proj.Name.Equals("Default", StringComparison.OrdinalIgnoreCase) Then
                        defaultProj = proj
                        Exit For
                    End If
                Next

                If defaultProj IsNot Nothing AndAlso
           Not projMgr.ActiveDesignProject.Name.Equals("Default", StringComparison.OrdinalIgnoreCase) Then

                    defaultProj.Activate()
                    System.Threading.Thread.Sleep(800)
                End If
            Catch ex As Exception
                MsgBox("⚠️ Could not switch to Default project. Continuing anyway..." & vbCrLf & ex.Message, MsgBoxStyle.Exclamation, "Warning")
            End Try

            '---------------------------------
            ' Step 4: Check if project already exists
            '---------------------------------
            Dim existingProject As DesignProject = Nothing
            For Each proj As DesignProject In projMgr.DesignProjects
                If proj.FullFileName.Equals(projectFilePath, StringComparison.OrdinalIgnoreCase) Then
                    existingProject = proj
                    Exit For
                End If
            Next

            Dim newProj As DesignProject = Nothing

            '---------------------------------
            ' Step 5: Create or load project
            '---------------------------------
            If existingProject Is Nothing Then
                Try
                    If System.IO.File.Exists(projectFilePath) Then
                        newProj = projMgr.DesignProjects.AddExisting(projectFilePath)
                    Else
                        newProj = projMgr.DesignProjects.Add(MultiUserModeEnum.kSingleUserMode, safeWorkOrder, workOrderFolder)
                    End If
                Catch ex As Exception
                    MsgBox("❌ Failed to create or load project." & vbCrLf &
                   "Error: " & ex.Message & vbCrLf & ex.StackTrace,
                   MsgBoxStyle.Critical, "Create Project Failed")
                    Exit Sub
                End Try
            Else
                newProj = existingProject
                MsgBox("ℹ️ Project already exists. Using existing one: " & newProj.Name, MsgBoxStyle.Information, "Step 2")
            End If


            ' Step 7: Activate project
            '---------------------------------
            Try

                Dim timeout As Date = Now.AddSeconds(5)
                Do Until projMgr.ActiveDesignProject.Name.Equals(newProj.Name, StringComparison.OrdinalIgnoreCase)
                    System.Threading.Thread.Sleep(300)
                    System.Windows.Forms.Application.DoEvents()
                    If Now > timeout Then Exit Do
                Loop

                newProj.Activate()
                System.Threading.Thread.Sleep(600)

            Catch actEx As Exception
                MsgBox("⚠️ Project was created but could not be activated automatically." & vbCrLf &
               "Error: " & actEx.Message, MsgBoxStyle.Exclamation, "Activation Warning")
            End Try


            '---------------------------------
            ' Step 6: Remove Read-only attribute (NEW PART)
            '---------------------------------
            Dim ipjPath As String = projectFilePath
            If System.IO.File.Exists(ipjPath) Then
                Dim fileAttr = System.IO.File.GetAttributes(ipjPath)
                If (fileAttr And FileAttributes.ReadOnly) = FileAttributes.ReadOnly Then
                    System.IO.File.SetAttributes(ipjPath, fileAttr And Not FileAttributes.ReadOnly)
                End If
            End If

            '---------------------------------
            ' Step 8: Verify activation
            '---------------------------------
            If projMgr.ActiveDesignProject.Name.Equals(newProj.Name, StringComparison.OrdinalIgnoreCase) Then
                MsgBox("✅ Project activated successfully: " & newProj.Name, MsgBoxStyle.Information, "Activation")
            Else
                MsgBox("⚠️ Project created but not activated automatically." & vbCrLf &
