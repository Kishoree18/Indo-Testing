    Private Sub Button3_Click(sender As Object, e As EventArgs) Handles Button3.Click

        Try

            Dim directoryPath As String = Outputlocation.Text
            Dim librarypath As String = librarylocation.Text

            ' ====== USER INPUTS ======
            Dim userName As String = Main_Panel.userTxt.Text.Trim()
            Dim workOrderNo As String = wk_odr_No.Text.Trim()
            Dim sourcePath As String = directoryPath.Trim()   ' old template source
            Dim invApp As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")

            ' ====== BUILD DIRECTORY STRUCTURE ======
            Dim basePath As String = "C:\Indotech"
            Dim projectFolder As String = System.IO.Path.Combine(basePath, "Projects")
            Dim workOrderFolder As String = System.IO.Path.Combine(projectFolder, workOrderNo)

            ' ====== Ensure base folders exist ======
            If Not Directory.Exists(basePath) Then Directory.CreateDirectory(basePath)
            If Not Directory.Exists(projectFolder) Then Directory.CreateDirectory(projectFolder)

            ' ====== CASE 1: Folder already exists ======
            If Directory.Exists(workOrderFolder) Then

                directoryPath = workOrderFolder
                librarypath = workOrderFolder & "\Standard parts"

                bottom_tank_parameter_save(directoryPath)
                Create_bottom_tank(directoryPath, librarypath)

            Else

                Directory.CreateDirectory(workOrderFolder)

                Dim sourceDir As New DirectoryInfo(sourcePath)
                Dim targetDir As New DirectoryInfo(workOrderFolder)
                Dim dirs As New Stack(Of DirectoryInfo)
                dirs.Push(sourceDir)

                Do While dirs.Count > 0
                    Dim currentSource As DirectoryInfo = dirs.Pop()
                    Dim relativePath As String = currentSource.FullName.Substring(sourceDir.FullName.Length).TrimStart("\"c)
                    Dim currentTargetPath As String = System.IO.Path.Combine(targetDir.FullName, relativePath)
                    Directory.CreateDirectory(currentTargetPath)

                    For Each f As FileInfo In currentSource.GetFiles()
                        Dim destFile As String = System.IO.Path.Combine(currentTargetPath, f.Name)
                        f.CopyTo(destFile, True)
                    Next

                    For Each subDir As DirectoryInfo In currentSource.GetDirectories()
                        dirs.Push(subDir)
                    Next
                Loop

                directoryPath = workOrderFolder
                librarypath = workOrderFolder & "\Standard parts"

                bottom_tank_parameter_save(directoryPath)
                Create_bottom_tank(directoryPath, librarypath)

            End If


        Catch ex As Exception
            MsgBox("❌ Error: " & ex.Message, MsgBoxStyle.Critical, "Error")
        End Try



    End Sub




