    Private Sub ForceShowAxesAndCenterlines(v As DrawingView)
        Try
            ' Show model work features
            v.ShowWorkFeatures = True
            v.ShowWorkPlanes = True
            v.ShowWorkAxes = True
            v.ShowCenterlines = True
        Catch
            ' Some Inventor versions don't support all flags – ignore safely
        End Try
    End Sub

    Private Sub ActivateAndRetrieveDimensions(v As DrawingView, s As Sheet, drwDoc As DrawingDocument)

        s.Activate()


        v.Activate()

        Try
            drwDoc.ObjectVisibility.SketchDimensions = True
            drwDoc.ObjectVisibility.ModelDimensions = True
            drwDoc.ObjectVisibility.DrawingDimensions = True
        Catch
        End Try

        Try
            v.RetrieveDimensions = True
        Catch
        End Try

    End Sub

