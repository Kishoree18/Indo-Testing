                    Dim asm As AssemblyDocument = CType(ThisApplication.ActiveDocument, AssemblyDocument)
                    Dim compDef As AssemblyComponentDefinition = asm.ComponentDefinition

                    Dim selectedOption As String = TFV_POS ' Example: "HV"

                    ' Dictionary where each part maps to its list of extrusions to delete
                    Dim platesToDelete As New Dictionary(Of String, List(Of String))()

                    ' Set plates and extrusions based on selected option
                    Select Case selectedOption.ToUpper()
                        Case "HV"
                            platesToDelete = New Dictionary(Of String, List(Of String)) From {
                {"TOP_LV_PLATE_OLTC_RIGHT", New List(Of String)({"FILTER_LV"})},
                {"TOP_SIDE_PLATE", New List(Of String)({"FILTER_OLTC_OPP"})},
                {"TOP_OLTC_SIDEPLATE_1", New List(Of String)({"FILTER_OLTC"})}
            }
                        Case "LV"
                            platesToDelete = New Dictionary(Of String, List(Of String)) From {
                {"TOP_HV_PLATE", New List(Of String)({"FILTER_HV"})},
                {"TOP_SIDE_PLATE", New List(Of String)({"FILTER_OLTC_OPP"})},
                {"TOP_OLTC_SIDEPLATE_1", New List(Of String)({"FILTER_OLTC"})}
            }
                        Case "OLTC SIDE"
                            platesToDelete = New Dictionary(Of String, List(Of String)) From {
                {"TOP_HV_PLATE", New List(Of String)({"FILTER_HV"})},
                {"TOP_LV_PLATE_OLTC_RIGHT", New List(Of String)({"FILTER_LV"})},
                {"TOP_SIDE_PLATE", New List(Of String)({"FILTER_OLTC_OPP"})}
            }
                        Case "OLTC OPP"
