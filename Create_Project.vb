                                Catch
                                    pl.Sort(pl.PartsListColumns.Item(1).Title, True)
                                End Try

                                pl.Update()
                            Catch
                            End Try
                        Next
                    Next

                    Dim oTG As TransientGeometry = invApp.TransientGeometry

                    ' ---------- VIEW SETUP ----------
                    For Each s As Sheet In drwDoc.Sheets
                        For Each v As DrawingView In s.DrawingViews
                            Dim viewName As String = v.Name.Trim().ToUpper()

                            If viewName = "HV_FRONT_VIEW" Or viewName = "BOTTOM_TOP_VIEW" Then
                                Try
                                    Dim targetRep As String = If(viewName = "HV_FRONT_VIEW", "UNDER_BASE_1", "UNDER_BASE_2")
