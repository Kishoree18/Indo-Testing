                                                            Dim targetParameters As Inventor.Parameters =
                                            bottomTankPartDef.Parameters


                                                            '================================
                                                            ' d196
                                                            '
                                                            ' TT_ITT_1194
                                                            ' mm
                                                            '================================

                                                            targetParameters.Item(
                                            "TT_ITT_1194"
                                        ).Expression =
                                            d196ValueMM.ToString(
                                                "0.###",
                                                System.Globalization.
                                                    CultureInfo.InvariantCulture
                                            ) &
                                            " mm"


                                                            '================================
                                                            ' d197
                                                            '
                                                            ' TT_ITT_1195
                                                            ' degree
                                                            '================================

                                                            targetParameters.Item(
                                            "TT_ITT_1195"
                                        ).Expression =
                                            d197ValueDegree.ToString(
                                                "0.###",
                                                System.Globalization.
                                                    CultureInfo.InvariantCulture
                                            ) &
                                            " deg"


                                                            '================================
                                                            ' d397
                                                            '
                                                            ' TT_ITT_1198
                                                            ' mm
                                                            '================================

                                                            targetParameters.Item(
                                            "TT_ITT_1198"
                                        ).Expression =
                                            d397ValueMM.ToString(
                                                "0.###",
                                                System.Globalization.
                                                    CultureInfo.InvariantCulture
                                            ) &
                                            " mm"


                                                            '================================
                                                            ' UPDATE
                                                            '================================

                                                            bottomTankPartDoc.Update()


                                                            '================================
                                                            ' SAVE
                                                            '================================

                                                            bottomTankPartDoc.Save()


                                                            '================================
                                                            ' CLOSE ONLY IF OPENED BY CODE
