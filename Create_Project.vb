    'currenly working
    Friend Sub AddBallonToFilteredView_Cooler(View As DrawingView, AllowedFiles As List(Of String))
        Try
            Dim oPL As PartsList = View.Parent.PartsLists.Item(1)
            InitialiseViewBoundingBox(View)

            ' 1. PRE-CLEAN ALLOWED LIST
            Dim allowedClean As New HashSet(Of String)
            For Each f In AllowedFiles
                allowedClean.Add(f.ToUpper().Replace(" ", "").Replace("_", "").Trim())
            Next

            ' 2. MAP VISIBLE BOM ROWS BY FILENAME FOR FAST ACCESS
            Dim fileToRowMap As New Dictionary(Of String, PartsListRow)
            For Each row As PartsListRow In oPL.PartsListRows
                If row.Visible And Not row.Ballooned Then
                    Dim fn = System.IO.Path.GetFileName(row.ReferencedFiles.Item(1).FullFileName).ToUpper().Trim()
                    Dim fnClean = fn.Replace(" ", "").Replace("_", "")
                    If Not fileToRowMap.ContainsKey(fnClean) Then fileToRowMap.Add(fnClean, row)
                End If
            Next

            ' 3. ITERATE EVERY CURVE IN THE VIEW
            ' This is the most reliable way: If a line is visible, we find what it is.
            Dim curvesInView As DrawingCurvesEnumerator = View.DrawingCurves()
            Dim processedFilesForThisView As New HashSet(Of String)

            For Each oCurve As DrawingCurve In curvesInView
                If oCurve Is Nothing Then Continue For

                ' Find the occurrence this line belongs to
                Dim oOcc As ComponentOccurrence = oCurve.ModelGeometry.ContainingOccurrence
                If oOcc Is Nothing Then Continue For

                ' Get the filename of the occurrence
                Dim occFileName As String = System.IO.Path.GetFileName(oOcc.Definition.Document.FullFileName).ToUpper().Trim()
                Dim occFileClean As String = occFileName.Replace(" ", "").Replace("_", "")

                ' Check if this filename is in our allowed list
                If allowedClean.Contains(occFileClean) AndAlso Not processedFilesForThisView.Contains(occFileClean) Then

                    ' Check if this file exists in our visible BOM rows
                    If fileToRowMap.ContainsKey(occFileClean) Then

                        Dim targetRow As PartsListRow = fileToRowMap(occFileClean)
                        Dim curveList As New List(Of DrawingCurve) From {oCurve}

                        Try
                            ' Call your internal project function
                            CreateRowItemBalloon(targetRow, View, curveList)
                            processedFilesForThisView.Add(occFileClean)
                        Catch : End Try
                    End If
                End If

                ' SPECIAL CHECK: If the part is INSIDE an assembly that is allowed (like RADIATOR.IAM)
                ' Check parent occurrences
                Dim parentOcc As ComponentOccurrence = oOcc.ParentOccurrence
                Do While parentOcc IsNot Nothing
                    Dim pName = System.IO.Path.GetFileName(parentOcc.Definition.Document.FullFileName).ToUpper().Trim()
                    Dim pNameClean = pName.Replace(" ", "").Replace("_", "")

                    If allowedClean.Contains(pNameClean) AndAlso Not processedFilesForThisView.Contains(pNameClean) Then
                        If fileToRowMap.ContainsKey(pNameClean) Then
                            Dim targetRow As PartsListRow = fileToRowMap(pNameClean)
                            Dim curveList As New List(Of DrawingCurve) From {oCurve}
                            Try
                                CreateRowItemBalloon(targetRow, View, curveList)
                                processedFilesForThisView.Add(pNameClean)
                            Catch : End Try
                        End If
                    End If
                    parentOcc = parentOcc.ParentOccurrence
                Loop
            Next

            ArrangeBalloonsOnView(View)
        Catch : End Try
    End Sub



