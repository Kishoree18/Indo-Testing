                        ' SPLIT TEMPLATE + NEW BASED ON ORIGINAL ORDER
                        '===================================================
                        Dim templateRows As New List(Of PartsListRow)
                        Dim newRows As New List(Of PartsListRow)

                        Dim foundFirstNew As Boolean = False

                        For Each row As PartsListRow In mainPL.PartsListRows

                            Dim itVal As String = row.Item(itCol).Value.ToString().Trim()

                            ' once blank encountered → remaining are new
                            If Not foundFirstNew AndAlso itVal <> "" AndAlso IsNumeric(itVal) Then
                                templateRows.Add(row)
                            Else
                                foundFirstNew = True
                                newRows.Add(row)
                            End If

                        Next


                        '===================================================
                        ' FUNCTION → GROUP ROWS INSIDE A BLOCK (NO REORDER)
                        '===================================================
                        Dim GroupRows =
        Sub(rows As List(Of PartsListRow))

            Dim map As New Dictionary(Of String, PartsListRow)

            For Each row In rows

                Dim desc As String = row.Item(descCol).Value.ToString().Trim()

                Dim qty As Integer = 0
                Integer.TryParse(row.Item(qtyCol).Value.ToString(), qty)

                If map.ContainsKey(desc) Then

                    Dim mainRow = map(desc)

                    Dim mainQty As Integer = 0
                    Integer.TryParse(mainRow.Item(qtyCol).Value.ToString(), mainQty)

                    mainRow.Item(qtyCol).Value = (mainQty + qty).ToString()

                    row.Visible = False

                Else
                    map.Add(desc, row)
                End If

            Next

        End Sub


                        '===================================================
                        ' GROUP BOTH BLOCKS SEPARATELY
                        '===================================================
