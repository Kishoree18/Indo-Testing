                parameters.Item("TT_ITT_1026").Expression = 25
                parameters.Item("TT_ITT_1027").Expression = 75

            ElseIf CB_Trunk_MP = "PSD-720-11" Then

                parameters.Item("TT_ITT_1155").Expression = 234
                parameters.Item("TT_ITT_1150").Expression = 12
                parameters.Item("TT_ITT_1151").Expression = 4.5
                parameters.Item("TT_ITT_1152").Expression = 22.5

                parameters.Item("TT_ITT_1022").Expression = 325
                parameters.Item("TT_ITT_1023").Expression = 225
                parameters.Item("TT_ITT_1024").Expression = 286
                parameters.Item("TT_ITT_1025").Expression = 16
                parameters.Item("TT_ITT_1026").Expression = 25
                parameters.Item("TT_ITT_1027").Expression = 75

            ElseIf CB_Trunk_MP = "PSD-720-12" Then

                parameters.Item("TT_ITT_1155").Expression = 470
                parameters.Item("TT_ITT_1150").Expression = 12
                parameters.Item("TT_ITT_1151").Expression = 4.5
                parameters.Item("TT_ITT_1152").Expression = 9

                parameters.Item("TT_ITT_1022").Expression = 560
                parameters.Item("TT_ITT_1023").Expression = 450
                parameters.Item("TT_ITT_1024").Expression = 520
                parameters.Item("TT_ITT_1025").Expression = 12
                parameters.Item("TT_ITT_1026").Expression = 20
                parameters.Item("TT_ITT_1027").Expression = 75

            End If

            'TERMINATION = TRUNK & DC - FIRE SENSORE MOUNTING
            If File_Sensor_Mounting = "Yes" Then

                If File_Sensor_Mounting_Make = "CTR" Then

                    parameters.Item("TT_ITT_1069").Expression = 0
                    parameters.Item("TT_ITT_1070").Expression = 1

                ElseIf File_Sensor_Mounting_Make = "EASUN MR" Then

                    parameters.Item("TT_ITT_1069").Expression = 1
                    parameters.Item("TT_ITT_1070").Expression = 0

                End If

            ElseIf File_Sensor_Mounting = "No" Then

                parameters.Item("TT_ITT_1069").Expression = 1
                parameters.Item("TT_ITT_1070").Expression = 1

            End If

            'TANK SUPPORT GUSSET QUANTITY TT_ITT_1148/250 = TT_ITT_1129
            Try

                '============================================================
                ' TT_ITT_1148 / 250 = TT_ITT_1129
                '============================================================

                Dim invApp As Inventor.Application =
        CType(
            System.Runtime.InteropServices.Marshal.GetActiveObject(
                "Inventor.Application"
            ),
            Inventor.Application
        )


                '============================================================
                ' CHECK ACTIVE DOCUMENT IS PART
                '============================================================

                If invApp.ActiveDocumentType =
        Inventor.DocumentTypeEnum.kPartDocumentObject Then


                    Dim activePartDoc As Inventor.PartDocument =
            CType(
                invApp.ActiveDocument,
                Inventor.PartDocument
            )


                    Dim activePartDef As Inventor.PartComponentDefinition =
            activePartDoc.ComponentDefinition


                    Dim activeParameters As Inventor.Parameters =
            activePartDef.Parameters


                    '========================================================
                    ' GET SOURCE PARAMETER
                    '
                    ' TT_ITT_1073
                    '========================================================

                    Dim sourceParameter As Inventor.Parameter =
            Nothing


                    Try

                        sourceParameter =
                activeParameters.Item(
                    "TT_ITT_1148"
                )

                    Catch

                        sourceParameter = Nothing

                    End Try


                    '========================================================
                    ' GET TARGET PARAMETER
                    '
                    ' TT_ITT_1129
                    '========================================================

                    Dim targetParameter As Inventor.Parameter =
            Nothing


                    Try

                        targetParameter =
                activeParameters.Item(
                    "TT_ITT_1129"
                )

                    Catch

                        targetParameter = Nothing

                    End Try


                    '========================================================
                    ' CHECK BOTH PARAMETERS EXIST
                    '========================================================

                    If sourceParameter Is Nothing Then

                        MsgBox(
                "Parameter TT_ITT_1148 was not found " &
                "inside the active part:" &
                vbCrLf &
                activePartDoc.DisplayName
            )


                    ElseIf targetParameter Is Nothing Then

                        MsgBox(
                "Parameter TT_ITT_1129 was not found " &
                "inside the active part:" &
                vbCrLf &
                activePartDoc.DisplayName
            )


                    Else


                        '====================================================
                        ' CONVERT TT_ITT_1148 TO MILLIMETERS
                        '====================================================

                        Dim sourceValueMM As Double =
                activePartDoc.UnitsOfMeasure.ConvertUnits(
                    sourceParameter.Value,
                    Inventor.UnitsTypeEnum.kDatabaseLengthUnits,
                    Inventor.UnitsTypeEnum.kMillimeterLengthUnits
                )


                        '====================================================
                        ' CALCULATION
                        '
                        ' TT_ITT_1148 / 250
                        '====================================================

                        Dim calculatedValue As Double =
                sourceValueMM / 250.0


                        '====================================================
                        ' TT_ITT_1129 IS UNITLESS
                        '
                        ' Therefore assign Value directly.
                        '====================================================

                        targetParameter.Value =
                calculatedValue


                        '====================================================
                        ' UPDATE ACTIVE PART
                        '====================================================

                        activePartDoc.Update()


                    End If


                Else

                    MsgBox(
            "Active document is not a Part document."
        )

                End If


            Catch ex As Exception

                MsgBox(
        "Error while calculating TT_ITT_1129:" &
        vbCrLf &
        vbCrLf &
        ex.ToString()
    )

            End Try

            '============================================================
            ' CB TYPE BASED PARAMETER MAPPING
            '============================================================

            'DC_SIDE:
            'TT_ITT_1074 -TT_ITT_1153
            'TT_ITT_1075 -TT_ITT_1154

            'DC_TOP:
            'TT_ITT_1064 -TT_ITT_1153
            'TT_ITT_1063 -TT_ITT_1154
            Try

                Dim cbTypeValue As String =
                CB_Type.Trim().ToUpperInvariant()


                If cbTypeValue = "SIDE" Then

                    '========================================================
                    ' SIDE
                    '
                    ' TT_ITT_1074 -> TT_ITT_1153
                    ' TT_ITT_1075 -> TT_ITT_1054
                    '========================================================

                    Dim source1074 As Inventor.Parameter =
                    parameters.Item(
                        "TT_ITT_1074"
                    )

                    Dim target1153 As Inventor.Parameter =
                    parameters.Item(
                        "TT_ITT_1153"
                    )

                    target1153.Expression =
                    source1074.Expression


                    Dim source1075 As Inventor.Parameter =
                    parameters.Item(
                        "TT_ITT_1075"
                    )

                    Dim target1054 As Inventor.Parameter =
                    parameters.Item(
                        "TT_ITT_1154"
                    )

                    target1054.Expression =
                    source1075.Expression


                ElseIf cbTypeValue = "TOP" Then

                    '========================================================
                    ' TOP
                    '
                    ' TT_ITT_1064 -> TT_ITT_1153
                    ' TT_ITT_1063 -> TT_ITT_1054
                    '========================================================

                    Dim source1064 As Inventor.Parameter =
                    parameters.Item(
                        "TT_ITT_1064"
                    )

                    Dim target1153 As Inventor.Parameter =
                    parameters.Item(
                        "TT_ITT_1153"
                    )

                    target1153.Expression =
                    source1064.Expression


                    Dim source1063 As Inventor.Parameter =
                    parameters.Item(
                        "TT_ITT_1063"
                    )

                    Dim target1054 As Inventor.Parameter =
                    parameters.Item(
                        "TT_ITT_1154"
                    )

                    target1054.Expression =
                    source1063.Expression

                End If

            Catch ex As Exception
                MsgBox("Exception : " & ex.ToString)
            End Try


        Catch ex As COMException
            ' If Inventor is not running, start a new instance
            Dim inventorAppType As Type = Type.GetTypeFromProgID("Inventor.Application")
            Main_Panel.ThisApplication = Activator.CreateInstance(inventorAppType)
            Main_Panel.ThisApplication.Visible = True
        End Try

    End Sub

