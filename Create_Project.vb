            ' Step 9: Summary (optional)
            '---------------------------------
            Dim workspacePath As String = ""
            Dim fullFileName As String = ""
            Try : workspacePath = newProj.WorkspacePath : Catch : End Try
            Try : fullFileName = newProj.FullFileName : Catch : End Try

            MsgBox("✅ Summary:" & vbCrLf &
           "Project: " & newProj.Name & vbCrLf &
           "Workspace: " & workspacePath & vbCrLf &
           "Full Path: " & fullFileName,
           MsgBoxStyle.Information, "Process Complete")

