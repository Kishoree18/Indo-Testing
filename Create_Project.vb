            parameters.Item("TT_ITT_1168").Expression = 10

        End If

        'BUCCHOLZ RELAY
        Try

            ' --- Connect to Inventor ---
            Dim invApp As Inventor.Application
            Try
                invApp = Marshal.GetActiveObject("Inventor.Application")
            Catch ex As Exception
                MsgBox("Inventor is not running.")
                Exit Sub
            End Try

            ' --- Open the assembly ---
            Dim CPASM_1 As String = System.IO.Path.Combine(directoryPath, "BUCHHOLZ_REALY.iam")
            Dim asmDoc As AssemblyDocument = invApp.Documents.Open(CPASM_1, False)

            If asmDoc Is Nothing Then
                MsgBox("Could not open assembly.")
                Exit Sub
            End If

            asmDoc.Update()

            ' --- Search for part BUCHHOLZ_REALYS_PIPE ---
            Dim partDoc1 As PartDocument = Nothing
            For Each comp As ComponentOccurrence In asmDoc.ComponentDefinition.Occurrences
                Dim partFileName As String = System.IO.Path.GetFileNameWithoutExtension(comp.ReferencedDocumentDescriptor.FullDocumentName)
                If String.Equals(partFileName, "BUCHHOLZ_REALYS_PIPE", StringComparison.OrdinalIgnoreCase) Then
                    If TypeOf comp.Definition.Document Is PartDocument Then
                        partDoc1 = CType(comp.Definition.Document, PartDocument)
                        Exit For
                    End If
                End If
            Next

            If partDoc1 Is Nothing Then
                MsgBox("Part 'BUCHHOLZ_REALYS_PIPE' not found in assembly.")
                Exit Sub
            End If

            partDoc1.Update()

            Dim typeName As String = B_R_Pipe_Connection

            Dim sketchName As String = ""
            Dim drivenDimName As String = ""
            Dim drivenDimName1 As String = ""

            Select Case typeName
                Case "Type 1"
                    sketchName = "Sketch34"
                    drivenDimName = "d115"
                    drivenDimName1 = "d151"
                Case "Type 2"
                    sketchName = "Sketch34"
                    drivenDimName = "d114"
                    drivenDimName1 = "d152"
                Case "Type 3"
                    sketchName = "Sketch34"
                    drivenDimName = "d113"
                    drivenDimName1 = "d153"
                Case Else
                    MsgBox("Invalid Type specified: " & typeName)
                    Exit Sub
            End Select


            Dim oSketch As PlanarSketch = Nothing
            For Each s As PlanarSketch In partDoc1.ComponentDefinition.Sketches
                If s.Name = sketchName Then
                    oSketch = s
                    Exit For
                End If
            Next

            If oSketch Is Nothing Then
                MsgBox("Sketch '" & sketchName & "' not found.")
                Exit Sub
            End If

            Dim drivenValue As Double = 0
            Dim drivenFound As Boolean = False

            '1 'Length
            For Each oDim As DimensionConstraint In oSketch.DimensionConstraints
                If oDim.Driven AndAlso oDim.Parameter.Name = drivenDimName Then
                    drivenFound = True
                    drivenValue = oDim.Parameter._Value   ' cm (internal)
                    Exit For
                End If
            Next

            If drivenFound Then
                Dim valueInMM As Double = invApp.ActiveDocument.UnitsOfMeasure.ConvertUnits(
            drivenValue, UnitsTypeEnum.kDatabaseLengthUnits, UnitsTypeEnum.kMillimeterLengthUnits)

                Dim result As Double = 0

                'Length
                If B_R_Pipe_Connection = "Type 1" Then
                    result = valueInMM - 2867
                    parameters.Item("TT_ITT_0998").Expression = result.ToString
                ElseIf B_R_Pipe_Connection = "Type 2" Then
                    result = valueInMM - 2872
                    parameters.Item("TT_ITT_0998").Expression = result.ToString
                ElseIf B_R_Pipe_Connection = "Type 3" Then
                    result = valueInMM - 2877
                    parameters.Item("TT_ITT_0998").Expression = result.ToString
                End If

                'Cut
                If B_R_Pipe_Connection = "Type 1" Then
                    parameters.Item("TT_ITT_1003").Expression = valueInMM.ToString
                ElseIf B_R_Pipe_Connection = "Type 2" Then
                    parameters.Item("TT_ITT_1004").Expression = valueInMM.ToString
                ElseIf B_R_Pipe_Connection = "Type 3" Then
                    parameters.Item("TT_ITT_1005").Expression = valueInMM.ToString
                End If

            Else
                MsgBox("Driven dimension '" & drivenDimName & "' not found in sketch '" & sketchName & "'.")
            End If

            '2 'Angle
            For Each oDim As DimensionConstraint In oSketch.DimensionConstraints
                If oDim.Driven AndAlso oDim.Parameter.Name = drivenDimName1 Then
                    drivenFound = True
                    drivenValue = oDim.Parameter._Value   ' cm (internal)
                    Exit For
                End If
            Next

            If drivenFound Then
                Dim valueInMM As Double = invApp.ActiveDocument.UnitsOfMeasure.ConvertUnits(
            drivenValue, UnitsTypeEnum.kRadianAngleUnits, UnitsTypeEnum.kDegreeAngleUnits)

                Dim result As Double = valueInMM
                If B_R_Pipe_Connection = "Type 1" Then
                    parameters.Item("TT_ITT_0999").Expression = result.ToString
                ElseIf B_R_Pipe_Connection = "Type 2" Then
                    parameters.Item("TT_ITT_1000").Expression = result.ToString
                ElseIf B_R_Pipe_Connection = "Type 3" Then
                    parameters.Item("TT_ITT_1001").Expression = result.ToString
                End If
            Else
                MsgBox("Driven dimension '" & drivenDimName1 & "' not found in sketch '" & sketchName & "'.")
            End If

        Catch ex As Exception
            MsgBox("Error: " & ex.Message & vbCrLf & vbCrLf & ex.StackTrace)
        End Try

        If B_R_Pipe_Connection = "Type 1" Then
            parameters.Item("TT_ITT_1002").Expression = 97
        ElseIf B_R_Pipe_Connection = "Type 2" Then
            parameters.Item("TT_ITT_1002").Expression = 96
        ElseIf B_R_Pipe_Connection = "Type 3" Then
            parameters.Item("TT_ITT_1002").Expression = 95
        End If

        'OIL LEVEL GAUGE
        Try
            Dim value As Double = parameters.Item("TT_ITT_0701").Value * 10

            If value >= 500 AndAlso value <= 700 Then
                parameters.Item("TT_ITT_1009").Expression = 65
            ElseIf value >= 800 AndAlso value <= 1100 Then
                parameters.Item("TT_ITT_1009").Expression = 65
            ElseIf value >= 1200 AndAlso value <= 1500 Then
                parameters.Item("TT_ITT_1009").Expression = 100
            End If
        Catch ex As Exception
            MsgBox("Error : " & ex.ToString)
        End Try

        'IITL_Monogram_plate
        If IITL_Monogram_plate = "1800x375" Then

            parameters.Item("TT_ITT_1178").Expression = 1800
            parameters.Item("TT_ITT_1179").Expression = 375

        ElseIf IITL_Monogram_plate = "1500x315" Then

            parameters.Item("TT_ITT_1178").Expression = 1500
            parameters.Item("TT_ITT_1179").Expression = 315

        ElseIf IITL_Monogram_plate = "1200x250" Then

            parameters.Item("TT_ITT_1178").Expression = 1200
            parameters.Item("TT_ITT_1179").Expression = 250

        ElseIf IITL_Monogram_plate = "600x125" Then

            parameters.Item("TT_ITT_1178").Expression = 600
            parameters.Item("TT_ITT_1179").Expression = 125

        End If

        'BOTTOM COOLERPIPE POSITION
        If CB_BottomCP_POS = "Angle" Then

            parameters.Item("TT_ITT_1188").Expression = 1

        ElseIf CB_BottomCP_POS = "Straight" Then

            parameters.Item("TT_ITT_1188").Expression = 0

        End If

        'TOP COOLERPIPE POSITION
        If CB_TopCP_POS = "Angle" Then

            parameters.Item("TT_ITT_1189").Expression = 0

        ElseIf CB_TopCP_POS = "Straight" Then

            parameters.Item("TT_ITT_1189").Expression = 1

        End If

        'RADIATOR PLATE SIZE
        Try

            '============================================================
            ' GET TT_ITT_0584 VALUE
            '============================================================

            Dim sourceValue As Double =
                CDbl(
                    parameters.Item(
                        "TT_ITT_0584"
                    ).Value
                )


            '============================================================
            ' GET RADIATOR COUNT
            '============================================================

            Dim radiatorCount As Integer =
                0


            Integer.TryParse(
                Convert.ToString(N0_RAD_HV).Trim(),
                radiatorCount
            )


            If radiatorCount >= 3 AndAlso
               radiatorCount <= 8 Then


                '========================================================
                ' MULTIPLIERS
                '
                ' TT_ITT_1196 = ODD SIDE
                ' TT_ITT_1197 = EVEN SIDE
                '========================================================

                Dim multiplier1196 As Integer =
                    1

                Dim multiplier1197 As Integer =
                    1


                Select Case radiatorCount

                    Case 3

                        multiplier1196 =
                            1

                        multiplier1197 =
                            1


                    Case 4

                        multiplier1196 =
                            1

                        multiplier1197 =
                            2


                    Case 5

                        multiplier1196 =
                            2

                        multiplier1197 =
                            2


                    Case 6

                        multiplier1196 =
                            2

                        multiplier1197 =
                            3


                    Case 7

                        multiplier1196 =
                            3

                        multiplier1197 =
                            3


                    Case 8

                        multiplier1196 =
                            3

                        multiplier1197 =
                            4

                End Select


                '========================================================
                ' CALCULATE TARGET VALUES
                '========================================================

                Dim value1196 As Double =
                    sourceValue *
                    multiplier1196


                Dim value1197 As Double =
                    sourceValue *
                    multiplier1197


                '========================================================
                ' TT_ITT_1196
                '========================================================

                parameters.Item(
                    "TT_ITT_1196"
                ).Value =
                    value1196


                '========================================================
                ' TT_ITT_1197
                '========================================================

                parameters.Item(
                    "TT_ITT_1197"
                ).Value =
                    value1197


                '========================================================
                ' UPDATE AND SAVE EXISTING BOTTOM_TANK_PARAMETER.ipt
                '========================================================

                partDoc.Update()
                partDoc.Save()


            Else

                MsgBox(
                    "Invalid N0_RAD_HV value." &
                    vbCrLf &
                    vbCrLf &
                    "Current Value = " &
                    Convert.ToString(N0_RAD_HV) &
                    vbCrLf &
                    vbCrLf &
                    "Valid values are 3, 4, 5, 6, 7 or 8."
                )

            End If


        Catch ex As Exception

            MsgBox(
                "Error while updating TT_ITT_1196 and TT_ITT_1197:" &
                vbCrLf &
                vbCrLf &
                ex.ToString()
            )

        End Try

        'BUCCHOLZ RELAY
        If cooler_bnk = "1x100%" Then

            parameters.Item("TT_ITT_1240").Expression = 65


        ElseIf cooler_bnk = "2x50%" Then

            parameters.Item("TT_ITT_1240").Expression = 0

        End If

    End Sub

