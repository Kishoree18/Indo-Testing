    Private Sub ApplyRulesRecursive(occs As ComponentOccurrences,
                                rules As Dictionary(Of String, Boolean),
                                ByRef hitCount As Integer)

        If rules Is Nothing Then Exit Sub

        For Each o As ComponentOccurrence In occs

            Dim fname As String =
            System.IO.Path.GetFileNameWithoutExtension(
            o.Definition.Document.FullFileName).ToUpper()

            For Each kv In rules
                If fname.StartsWith(kv.Key.ToUpper()) Then
                    o.Visible = kv.Value
                    hitCount += 1
                    Exit For
                End If
            Next

            If o.SubOccurrences.Count > 0 Then
                ApplyRulesRecursive(o.SubOccurrences, rules, hitCount)
            End If

        Next

    End Sub
