                {"TOP_LV_PLATE_OLTC_RIGHT", New List(Of String)({"FILTER_LV"})},
                {"TOP_OLTC_SIDEPLATE_1", New List(Of String)({"FILTER_OLTC"})}
            }
                        Case Else
                            MsgBox("Invalid option selected: " & selectedOption)
                            Exit Try
                    End Select

