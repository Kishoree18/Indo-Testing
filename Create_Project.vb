                End If

                Try

                    Dim invApp As Inventor.Application = Marshal.GetActiveObject("Inventor.Application")
                    Dim asmDoc As AssemblyDocument = TryCast(invApp.ActiveDocument, AssemblyDocument)

                    If asmDoc Is Nothing Then
                        MsgBox("Please open an assembly first.")
                        Exit Sub
                    End If

                    Dim firstLevelName As String = "TOP_COVER_TYPE_3_OLTC_RIGHT"
                    Dim secondLevelName As String = "TOP_COVER_RIGHT"

                    ' Search for first-level subassembly
                    For Each occ As ComponentOccurrence In asmDoc.ComponentDefinition.Occurrences
                        Dim occFileName As String = System.IO.Path.GetFileNameWithoutExtension(occ.ReferencedDocumentDescriptor.FullDocumentName)

                        If String.Equals(occFileName, firstLevelName, StringComparison.OrdinalIgnoreCase) Then

                            ' Search inside first-level subassembly for the part
                            Dim subAsmDoc As AssemblyDocument = CType(occ.Definition.Document, AssemblyDocument)
                            For Each subOcc As ComponentOccurrence In subAsmDoc.ComponentDefinition.Occurrences
                                Dim subOccFileName As String = System.IO.Path.GetFileNameWithoutExtension(subOcc.ReferencedDocumentDescriptor.FullDocumentName)

                                If String.Equals(subOccFileName, secondLevelName, StringComparison.OrdinalIgnoreCase) Then

                                    ' Get PartDocument
                                    Dim partDoc As Inventor.PartDocument = CType(subOcc.Definition.Document, Inventor.PartDocument)
                                    Dim partDef As Inventor.PartComponentDefinition = partDoc.ComponentDefinition

                                    ' Delete extrusions BL_2 and BL_3
                                    For Each feat As Inventor.ExtrudeFeature In partDef.Features.ExtrudeFeatures
                                        If feat.Name = "BL_3" Then
                                            feat.Delete()
                                        End If
                                    Next


                                    Exit For
                                End If
                            Next

