                                        directoryPath,
                                        fileName
                                    )


                                                    If System.IO.File.Exists(filePath) Then

                                                        Dim bottomTankPartDoc As Inventor.PartDocument =
                                        Nothing

                                                        Dim bottomTankOpenedByCode As Boolean =
                                        False


                                                        '================================
                                                        ' CHECK IF PART ALREADY OPEN
                                                        '================================

                                                        For Each openDoc As Inventor.Document _
                                        In invApp.Documents

                                                            Try

                                                                If String.Equals(
