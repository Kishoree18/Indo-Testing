                    'drwDoc.Close(True)

                Next

                MsgBox("✅ Cooler Bank drawings updated successfully.")

            Catch ex As Exception
                MsgBox("❌ Error: " & ex.Message & vbCrLf & ex.StackTrace)
            End Try

        End If


    End Sub

    Private Sub ProcessRadiatorElements(coolerOcc As ComponentOccurrence)

        For Each radOcc As ComponentOccurrence In coolerOcc.SubOccurrences

            Dim radName As String = radOcc.Name.Split(":"c)(0).ToUpper()

            If radName = "RADIATOR" Then

                Dim idx As Integer = CInt(radOcc.Name.Split(":"c)(1))

                If idx = 20 OrElse idx = 27 Then

                    'MsgBox("🔍 Found RADIATOR:" & idx)

                    For Each elemOcc As ComponentOccurrence In radOcc.SubOccurrences

                        Dim elemIdx As Integer = CInt(elemOcc.Name.Split(":"c)(1))

                        If {1, 2, 3, 28, 29, 30}.Contains(elemIdx) Then

                            'MsgBox("    Making visible: " & elemOcc.Name)
                            elemOcc.Visible = True
                        End If

                    Next
                End If
            End If
        Next
    End Sub

    Private Sub Button12_Click(sender As Object, e As EventArgs) Handles Button12.Click

        Try
            Dim workOrderNo As String = wk_odr_No.Text.Trim()

            ' === Get Inventor application ===
            Dim invApp As Inventor.Application =
        CType(Marshal.GetActiveObject("Inventor.Application"), Inventor.Application)

            ' === Define folder structure ===
            Dim basePath As String = "C:\Indotech"
            Dim projectFolder As String = IO.Path.Combine(basePath, "Projects")
            Dim workOrderFolder As String = IO.Path.Combine(projectFolder, workOrderNo)

            Dim fileName = "OGA.idw"

            Dim fullPath As String = IO.Path.Combine(workOrderFolder, fileName)

            If Not IO.File.Exists(fullPath) Then
                MsgBox("⚠ Drawing not found: " & fullPath)

            End If

            ' === Open drawing visibly ===
            Dim drwDoc As DrawingDocument =
            CType(invApp.Documents.Open(fullPath, True), DrawingDocument)

            ' === Update all drawing views safely ===
            For Each s As Sheet In drwDoc.Sheets
                For Each v As DrawingView In s.DrawingViews
                    Try
                        v.Update()
                    Catch
                        ' Ignore individual view update errors
                    End Try
                Next
            Next

            ' === Single drawing update ===
            drwDoc.Update()

            ' === Save & close (CRITICAL) ===
            drwDoc.Save()
            'drwDoc.Close(True)

            MsgBox("OGA Drawings Updated Successfully!")

        Catch ex As Exception
            MsgBox("❌ Error: " & ex.Message & vbCrLf & ex.StackTrace)
        End Try

    End Sub

