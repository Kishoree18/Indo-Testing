                                '================================================

                                Dim bottomCoverCount As Integer = 0
                                Dim topCoverCount As Integer = 0


                                '================================================
                                ' LOOP THROUGH EVERY OCCURRENCE
                                ' INSIDE TRUNK_NEW_FOR_CB.iam
                                '================================================

                                For Each comp As Inventor.ComponentOccurrence _
                        In trunkAsmDef.Occurrences


                                    Dim browserName As String =
                            comp.Name.
                            Split(":"c)(0).
                            Trim().
                            ToUpperInvariant()


                                    Dim actualFileName As String = ""


                                    Try

                                        actualFileName =
                                System.IO.Path.
                                GetFileNameWithoutExtension(
                                    comp.ReferencedDocumentDescriptor.
                                    FullDocumentName
                                ).
                                Trim().
                                ToUpperInvariant()

                                    Catch

                                        actualFileName = ""

                                    End Try


