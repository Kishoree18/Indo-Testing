                    For Each oComp As ComponentOccurrence In compDef.Occurrences
                        Dim baseName As String = oComp.Name.Split(":"c)(0).Trim().Replace(".ipt", "").Trim()

                        ' Check if this part is in the dictionary
                        If platesToDelete.ContainsKey(baseName) Then
                            Dim partDoc As PartDocument = CType(oComp.Definition.Document, PartDocument)
                            Dim partDef As PartComponentDefinition = partDoc.ComponentDefinition

                            Dim extrusionsToDelete As List(Of String) = platesToDelete(baseName)

                            ' Iterate through extrusions and delete if name matches
                            For Each feat As ExtrudeFeature In partDef.Features.ExtrudeFeatures
                                If extrusionsToDelete.Any(Function(n) feat.Name.ToUpper().StartsWith(n.ToUpper())) Then
                                    Try
                                        feat.Delete()
                                    Catch ex As Exception
                                        MsgBox("Failed to delete extrusion: " & feat.Name & " | Error: " & ex.Message)
                                    End Try
                                End If
                            Next
