                        System.IO.Path.
                        GetFileNameWithoutExtension(
                            occ.ReferencedDocumentDescriptor.
                            FullDocumentName
                        ).
                        Trim().
                        ToUpperInvariant()

                            Catch

                                actualFileName = ""

                            End Try


