    Public Sub Load_CoolerBank_CB()

        Try


            Dim wk_odr_No As String = Create_Project.wk_ord_No

            'Dim connectionString As String = "Server=192.168.7.70,1433;Database=Indo_tech;User ID=sa;Password=Indo@123"
            Dim connection As New SqlConnection(Main_Panel.connectionString)

            connection.Open()
            Dim query As String = "SELECT * from CoolerBank_CB WHERE wk_odr_No = @wk_odr_No"

            Dim cmd As New SqlCommand(query, connection)
            cmd.Parameters.AddWithValue("@wk_odr_No", wk_odr_No)
            Dim reader As SqlDataReader = cmd.ExecuteReader()

            While reader.Read()
                'Main_Panel.userTxt.Text = reader("Username").ToString()
                CB_MOUNT.SelectedItem = reader("CB_MOUNT").ToString()
                cooler_bnk.SelectedItem = reader("cooler_bnk").ToString()
                cooler_bnk_pos1.SelectedItem = reader("cooler_bnk_pos1").ToString()
                cooler_bnk_pos2.SelectedItem = reader("cooler_bnk_pos2").ToString()
                cooler_bnk_pos3.SelectedItem = reader("cooler_bnk_pos3").ToString()
                typ_of_cooling.SelectedItem = reader("typ_of_cooling").ToString()
                header_pipe_size_bot.SelectedItem = reader("header_pipe_size_bot").ToString()

                'ONAN
                ONAN_butterfly_valve_size.SelectedItem = reader("header_pipe_size_bot").ToString()
                'ONAF
                BF_VL_ONAF.SelectedItem = reader("header_pipe_size_bot").ToString()
                'ODAF
                ODAF_butterfly_valve_size.SelectedItem = reader("header_pipe_size_bot").ToString()

                Radiator_size_C_C.Text = reader("Radiator_size_C_C").ToString()
                Radiator_size_FINS.Text = reader("Radiator_size_FINS").ToString()
                Radiator_size_W.Text = reader("Radiator_size_W").ToString()
                Radiator_size_QTY.Text = reader("Radiator_size_QTY").ToString()

                Radiator_pipe_size.SelectedItem = reader("Radiator_pipe_size").ToString()
                Ground_Support_Reg.SelectedItem = reader("Ground_Support_Reg").ToString()
                Radiator_drain1.SelectedItem = reader("Radiator_drain1").ToString()
                Radiator_drain2.SelectedItem = reader("Radiator_drain2").ToString()

                CB_TopCP_POS.SelectedItem = reader("CB_TopCP_POS").ToString()
                CB_BottomCP_POS.SelectedItem = reader("CB_BottomCP_POS").ToString()


            End While

            connection.Close()

        Catch ex As Exception
            MsgBox("Error" & ex.ToString)
        End Try

    End Sub

