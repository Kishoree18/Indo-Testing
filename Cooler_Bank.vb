    Private Sub IFRAME_ONAF_SelectedIndexChanged(sender As Object, e As EventArgs) Handles IFRAME_ONAF.SelectedIndexChanged
        If IFRAME_ONAF.SelectedItem = "No" Then

            ID1F.Enabled = False
            ID2F.Enabled = False

        ElseIf IFRAME_ONAF.SelectedItem = "1" Then

            ID1F.Enabled = True
            ID2F.Enabled = False

        ElseIf IFRAME_ONAF.SelectedItem = "2" Then

            ID1F.Enabled = True
            ID2F.Enabled = True

        End If
    End Sub

    Private Sub CB_TopCP_POS_SelectedIndexChanged(sender As Object, e As EventArgs) Handles CB_TopCP_POS.SelectedIndexChanged

        If CB_TopCP_POS.SelectedItem = "Angle" Then

            P4L_LVT.Enabled = True
            P5L_LVT.Enabled = True
            P6L_LVT.Enabled = True

            P4L_HVT.Enabled = True
            P5L_HVT.Enabled = True
            P6L_HVT.Enabled = True

        ElseIf CB_TopCP_POS.SelectedItem = "Straight" Then

            P4L_LVT.Enabled = False
            P5L_LVT.Enabled = False
            P6L_LVT.Enabled = False

            P4L_HVT.Enabled = False
            P5L_HVT.Enabled = False
            P6L_HVT.Enabled = False

        End If
    End Sub
