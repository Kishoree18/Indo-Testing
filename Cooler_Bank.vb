    Private Sub cooler_bnk_SelectedIndexChanged(sender As Object, e As EventArgs) Handles cooler_bnk.SelectedIndexChanged



        Load_OLTC_Pkt_Position()

        If OLTC_pkt_position = "Left" Then

            If CB_MOUNT.SelectedItem = "Com-Header" Then

                If cooler_bnk.SelectedItem = "1x100%" Then

                    CB_picbox.Image = My.Resources.CB_HV_T1L
                    cooler_bnk_pos1.Enabled = True
                    cooler_bnk_pos2.Enabled = False
                    cooler_bnk_pos3.Enabled = False
                ElseIf cooler_bnk.SelectedItem = "2x50%" Then

                    CB_picbox.Image = My.Resources.CB_HV_LV_T1L

                    cooler_bnk_pos1.Enabled = True
                    cooler_bnk_pos2.Enabled = True
                    cooler_bnk_pos3.Enabled = False
                ElseIf cooler_bnk.SelectedItem = "3x33.33%" Then
                    CB_picbox.Image = My.Resources.CB_HVLVOE_T1_L

                    cooler_bnk_pos1.Enabled = True
                    cooler_bnk_pos2.Enabled = True
                    cooler_bnk_pos3.Enabled = True
