    Public Sub CollerBank_CB()

        Try
            ' Connection string
            'Dim connectionString As String = "Server=CTPL-HW-198\SQLEXPRESS;Initial Catalog=Indo_tech;User ID=sqladmin;Password=Cadopt@123"
            'Dim connectionString As String = "Server=192.168.7.70,1433;Database=Indo_tech;User ID=sa;Password=Indo@123"
            Dim connection As New SqlConnection(Main_Panel.connectionString)
            connection.Open()

            ' Step 1: Check if wk_odr_No already exists
            Dim checkQuery As String = "SELECT COUNT(*) FROM CoolerBank_CB WHERE wk_odr_No = @wk_odr_No"
            Dim checkCmd As New SqlCommand(checkQuery, connection)
            checkCmd.Parameters.AddWithValue("@wk_odr_No", Create_Project.wk_ord_No)
            Dim count As Integer = Convert.ToInt32(checkCmd.ExecuteScalar())

            ' Step 2: Decide INSERT or UPDATE query
            Dim query As String
            If count > 0 Then
                query = "UPDATE CoolerBank_CB SET 
            Username=@Username,
            CB_MOUNT=@CB_MOUNT,
            cooler_bnk=@cooler_bnk,
            cooler_bnk_pos1=@cooler_bnk_pos1,
            cooler_bnk_pos2=@cooler_bnk_pos2,
            cooler_bnk_pos3=@cooler_bnk_pos3,
            typ_of_cooling=@typ_of_cooling,
            header_pipe_size_bot=@header_pipe_size_bot,
            Radiator_size_C_C=@Radiator_size_C_C,
            Radiator_size_FINS=@Radiator_size_FINS,
            Radiator_size_W=@Radiator_size_W,
            Radiator_size_QTY=@Radiator_size_QTY,
            Radiator_pipe_size=@Radiator_pipe_size,
            Ground_Support_Reg=@Ground_Support_Reg,
            Radiator_drain1=@Radiator_drain1,
            Radiator_drain2=@Radiator_drain2,
            CB_TopCP_POS=@CB_TopCP_POS,
            CB_BottomCP_POS=@CB_BottomCP_POS
            WHERE wk_odr_No=@wk_odr_No"
            Else
                '    query = "INSERT INTO CoolerBank_CB(
                'Username, wk_odr_No, CB_MOUNT, cooler_bnk, cooler_bnk_pos1, cooler_bnk_pos2, cooler_bnk_pos3,
                'typ_of_cooling, header_pipe_size_bot, Radiator_size_C_C, Radiator_size_FINS, Radiator_size_W,
                'Radiator_size_QTY, Radiator_pipe_size, Ground_Support_Reg, Radiator_drain1, Radiator_drain2)
                'VALUES (
                '@Username, @wk_odr_No, @CB_MOUNT, @cooler_bnk, @cooler_bnk_pos1, @cooler_bnk_pos2, @cooler_bnk_pos3,
                '@typ_of_cooling, @header_pipe_size_bot, @Radiator_size_C_C, @Radiator_size_FINS, @Radiator_size_W,
