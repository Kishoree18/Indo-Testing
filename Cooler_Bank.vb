        If conservator_breather_cmb.SelectedItem = "Conventional Breather" Then

            conservator_breather_type.Items.Add("Type 1")
            conservator_breather_type.Items.Add("Type 2")
            conservator_breather_type.Items.Add("Type 3")
        ElseIf conservator_breather_cmb.SelectedItem = "Smart Breather" Then

            conservator_breather_type.Items.Add("Type 1")
        End If

        If conservator_breather_type.Items.Count > 0 Then
            conservator_breather_type.SelectedItem = "Type 1"
        End If


    End Sub

